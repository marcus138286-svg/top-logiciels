---
import '../styles/global.css'
import Chatbot from '../components/Chatbot.astro'
import SchemaOrg from '../components/SchemaOrg.astro'
import CookieBanner from '../components/CookieBanner.astro'
import AffiliateTracker from '../components/AffiliateTracker.astro'

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Comparatifs et codes promo pour les meilleurs logiciels SaaS", image = "/og-image.svg" } = Astro.props;
const siteUrl = "https://top-logiciels.fr";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={siteUrl + Astro.url.pathname} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + image} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Top-Logiciels" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + image} />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>
    <!-- Umami Analytics (RGPD-compliant, sans cookies) -->
    <!-- À configurer : créer un compte sur https://cloud.umami.is et remplacer data-website-id -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="YOUR_WEBSITE_ID"></script>
    <!-- Schema.org -->
    <SchemaOrg type="website" />
  </head>
  <body class="bg-gray-950 text-white min-h-screen" style="font-family: 'Inter', sans-serif;">

    <!-- Background effects -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-violet-600/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 right-0 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl"></div>
    </div>

    <nav class="relative z-10 glass border-b border-white/10">
      <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold">
          <span class="gradient-text">Top</span>-<span class="text-gold">Logiciels</span>
        </a>

        <!-- Desktop menu -->
        <div class="hidden md:flex gap-6 text-sm items-center">
          <a href="/comparatif/email-marketing" class="text-gray-400 hover:text-white transition">Email</a>
          <a href="/comparatif/crm" class="text-gray-400 hover:text-white transition" title="Gestion de la Relation Client">CRM</a>
          <a href="/comparatif/outils-ia" class="text-gray-400 hover:text-white transition">IA</a>
          <a href="/comparatif/compta-finance" class="text-gray-400 hover:text-white transition">Compta</a>
          <a href="/avis" class="text-gray-400 hover:text-white transition">Avis</a>
          <a href="/blog" class="text-gray-400 hover:text-white transition">Blog</a>
          <a href="/codes-promo" class="bg-gold text-gray-900 px-4 py-1.5 rounded-full font-medium hover:opacity-90 transition">Promos</a>
        </div>

        <!-- Mobile burger button -->
        <button id="mobile-menu-btn" class="md:hidden text-white text-2xl" aria-label="Menu">
          <span id="burger-icon">☰</span>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-white/10">
        <div class="px-4 py-4 space-y-3">
          <a href="/comparatif/email-marketing" class="block text-gray-400 hover:text-white transition py-2">📧 Email Marketing</a>
          <a href="/comparatif/crm" class="block text-gray-400 hover:text-white transition py-2">👥 CRM</a>
          <a href="/comparatif/outils-ia" class="block text-gray-400 hover:text-white transition py-2">🤖 Outils IA</a>
          <a href="/comparatif/compta-finance" class="block text-gray-400 hover:text-white transition py-2">💰 Compta & Finance</a>
          <a href="/avis" class="block text-gray-400 hover:text-white transition py-2">📝 Tous les Avis</a>
          <a href="/blog" class="block text-gray-400 hover:text-white transition py-2">📚 Blog</a>
          <a href="/codes-promo" class="block bg-gold text-gray-900 px-4 py-2 rounded-xl font-medium text-center mt-4">🎁 Codes Promo</a>
        </div>
      </div>
    </nav>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 border-t border-white/10 mt-20 py-10">
      <div class="max-w-6xl mx-auto px-4 text-center text-sm text-gray-500">
        <p>&copy; 2026 <span class="text-gold">Top-Logiciels</span> - Comparatifs et codes promo</p>
        <div class="mt-3 flex justify-center gap-6 flex-wrap">
          <a href="/a-propos" class="hover:text-white transition">À propos</a>
          <a href="/mentions-legales" class="hover:text-white transition">Mentions légales</a>
          <a href="/politique-confidentialite" class="hover:text-white transition">Confidentialité</a>
          <a href="/blog" class="hover:text-white transition">Blog</a>
        </div>
      </div>
    </footer>

    <Chatbot />
    <CookieBanner />
    <AffiliateTracker />

    <!-- Mobile menu script -->
    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const burgerIcon = document.getElementById('burger-icon');

      menuBtn?.addEventListener('click', () => {
        const isOpen = !mobileMenu?.classList.contains('hidden');
        mobileMenu?.classList.toggle('hidden');
        if (burgerIcon) {
          burgerIcon.textContent = isOpen ? '☰' : '✕';
        }
      });
    </script>
  </body>
</html>
