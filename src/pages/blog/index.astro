---
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    slug: "comment-choisir-crm",
    title: "Comment choisir son CRM en 2026 ?",
    description: "Guide complet pour trouver le logiciel de gestion relation client adapté à votre activité.",
    date: "15 septembre 2026",
    readTime: "5 min",
    category: "CRM"
  },
  {
    slug: "email-marketing-debutant",
    title: "Email Marketing : Le Guide du Débutant",
    description: "Tout ce qu'il faut savoir pour lancer vos premières campagnes email et newsletters.",
    date: "10 septembre 2026",
    readTime: "7 min",
    category: "Email"
  },
  {
    slug: "outils-ia-redaction",
    title: "Les Meilleurs Outils IA pour Rédiger en 2026",
    description: "Comparatif des assistants IA pour écrire vos contenus plus vite et mieux.",
    date: "5 septembre 2026",
    readTime: "4 min",
    category: "IA"
  }
];
---

<Layout title="Blog - Conseils Logiciels SaaS" description="Guides et conseils pour choisir et utiliser les meilleurs logiciels professionnels : CRM, email marketing, outils IA, comptabilité.">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">📚 <span class="gradient-text">Blog</span></h1>
    <p class="text-gray-400 mb-10">Guides et conseils pour bien choisir vos outils</p>

    <div class="space-y-6">
      {articles.map(article => (
        <a href={`/blog/${article.slug}`} class="block glass p-6 rounded-2xl card-hover group">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg text-xs">{article.category}</span>
                <span class="text-gray-500 text-sm">{article.date}</span>
                <span class="text-gray-600 text-sm">• {article.readTime}</span>
              </div>
              <h2 class="text-xl font-bold mb-2 group-hover:text-gold transition">{article.title}</h2>
              <p class="text-gray-400">{article.description}</p>
            </div>
            <span class="text-gray-600 group-hover:text-gold transition text-2xl">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
