---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Avis Axonaut 2026 - Test Complet CRM + Facturation, Prix et Conformité" description="Notre avis complet sur Axonaut : CRM, facturation, gestion tout-en-un. Conforme réforme 2026. Prix, fonctionnalités, commission 40%.">
  <article class="max-w-4xl mx-auto px-4 py-12">

    <div class="mb-8">
      <a href="/comparatif/facturation" class="text-purple-400 hover:text-purple-300 text-sm">← Comparatif Facturation</a>
    </div>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-4 mb-4">
        <img src="https://www.google.com/s2/favicons?domain=axonaut.com&sz=64" alt="Axonaut" class="w-16 h-16 rounded-xl" />
        <div>
          <h1 class="text-3xl font-bold">Avis <span class="gradient-text">Axonaut</span> 2026</h1>
          <p class="text-gray-400">Le tout-en-un français pour TPE/PME</p>
        </div>
      </div>
    </header>

    <!-- Badge conformité -->
    <div class="glass p-4 rounded-xl border border-green-500/50 mb-8 flex items-center gap-3">
      <span class="text-2xl">✅</span>
      <div>
        <p class="font-bold text-green-400">Plateforme agréée - Conforme réforme 2026</p>
        <p class="text-sm text-gray-400">Axonaut est officiellement immatriculé par la DGFiP</p>
      </div>
    </div>

    <!-- Résumé rapide -->
    <div class="glass p-6 rounded-2xl border border-gold/30 mb-8">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-3">
          <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-lg font-bold">⭐ 4.5/5</span>
          <span class="bg-green-500/20 text-green-400 px-3 py-1 rounded-lg text-sm">100% Français</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="line-through text-gray-500">69,99€/mois</span>
          <span class="text-2xl font-bold text-green-400">34,99€/mois</span>
          <span class="bg-red-500 text-white px-2 py-1 rounded-lg text-sm font-bold">-50%</span>
        </div>
      </div>
      <p class="text-gray-300">
        Axonaut est <span class="text-gold font-medium">la solution tout-en-un idéale pour les TPE/PME</span> qui veulent CRM, devis, factures, gestion et comptabilité dans un seul outil. Sans avoir besoin d'expert-comptable.
      </p>
    </div>

    <!-- Fiche technique -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">📋 Fiche technique</h2>
      <div class="glass rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-white/10">
            <tr>
              <td class="px-4 py-3 text-gray-400 w-1/3">Éditeur</td>
              <td class="px-4 py-3 font-medium">Axonaut (France - Toulouse)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-400">Fonctionnalités</td>
              <td class="px-4 py-3 font-medium">CRM, Devis, Factures, Gestion, Trésorerie, RH</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-400">Formats facture</td>
              <td class="px-4 py-3 font-medium text-green-400">Factur-X, PDF</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-400">Utilisateurs</td>
              <td class="px-4 py-3 font-medium">Illimités (1 seul prix)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-400">Plateforme agréée</td>
              <td class="px-4 py-3 text-green-400 font-medium">✓ Immatriculée DGFiP</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-400">Apps mobiles</td>
              <td class="px-4 py-3 font-medium">iOS, Android</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-400">Support</td>
              <td class="px-4 py-3 font-medium">Chat + Email + Téléphone (FR)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-400">Essai gratuit</td>
              <td class="px-4 py-3 font-medium text-gold">15 jours sans CB</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Fonctionnalités clés -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">🚀 Fonctionnalités clés</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="glass p-4 rounded-xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">🎯</span>
            <h3 class="font-bold">CRM intégré</h3>
          </div>
          <p class="text-sm text-gray-400">Gérez vos contacts, opportunités et pipeline commercial. Tout est lié aux devis et factures.</p>
        </div>
        <div class="glass p-4 rounded-xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">🧾</span>
            <h3 class="font-bold">Devis → Facture en 1 clic</h3>
          </div>
          <p class="text-sm text-gray-400">Transformez vos devis en factures instantanément. Relances automatiques des impayés.</p>
        </div>
        <div class="glass p-4 rounded-xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">📊</span>
            <h3 class="font-bold">Tableaux de bord</h3>
          </div>
          <p class="text-sm text-gray-400">CA, trésorerie, rentabilité projet... Tout visualisé en temps réel.</p>
        </div>
        <div class="glass p-4 rounded-xl">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">⚡</span>
            <h3 class="font-bold">Automatisations</h3>
          </div>
          <p class="text-sm text-gray-400">Emails automatiques, rappels, workflows. Gagnez du temps sur les tâches répétitives.</p>
        </div>
      </div>
    </section>

    <!-- Ce qui est inclus -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">📦 Tout ce qui est inclus</h2>
      <div class="glass p-6 rounded-2xl">
        <div class="grid md:grid-cols-3 gap-4 text-sm">
          <div>
            <h3 class="font-bold text-gold mb-2">Commercial</h3>
            <ul class="space-y-1 text-gray-400">
              <li>✓ CRM / Contacts</li>
              <li>✓ Pipeline de vente</li>
              <li>✓ Devis personnalisés</li>
              <li>✓ Catalogue produits</li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-gold mb-2">Facturation</h3>
            <ul class="space-y-1 text-gray-400">
              <li>✓ Factures Factur-X</li>
              <li>✓ Factures récurrentes</li>
              <li>✓ Relances auto</li>
              <li>✓ Paiement en ligne</li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold text-gold mb-2">Gestion</h3>
            <ul class="space-y-1 text-gray-400">
              <li>✓ Suivi trésorerie</li>
              <li>✓ Gestion achats</li>
              <li>✓ Gestion projets</li>
              <li>✓ Notes de frais</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Tarifs -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">💰 Tarifs</h2>
      <div class="glass p-6 rounded-xl border border-gold/50 text-center">
        <p class="text-gray-400 text-sm mb-1">Prix unique - Utilisateurs illimités</p>
        <div class="flex items-center justify-center gap-3 mb-2">
          <span class="line-through text-gray-500 text-xl">69,99€</span>
          <span class="text-4xl font-bold text-gold">34,99€</span>
          <span class="text-gray-400">/mois HT</span>
        </div>
        <span class="bg-red-500 text-white px-3 py-1 rounded-lg text-sm font-bold">-50% actuellement</span>
        <p class="text-gray-400 text-sm mt-4">Tout inclus : CRM, Facturation, Gestion, Support FR</p>
      </div>
      <p class="text-sm text-gray-500 mt-4">💡 Contrairement à Sellsy, pas de prix par utilisateur. Ajoutez toute votre équipe sans surcoût.</p>
    </section>

    <!-- Pour qui -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">⚖️ Pour qui ?</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="glass p-6 rounded-2xl">
          <h3 class="font-bold text-green-400 mb-4">✅ Idéal pour</h3>
          <ul class="space-y-2 text-gray-300 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-green-400 mt-0.5">→</span>
              <span>TPE/PME qui veulent tout centraliser</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-400 mt-0.5">→</span>
              <span>Entreprises sans expert-comptable dédié</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-400 mt-0.5">→</span>
              <span>Équipes commerciales + admin</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-400 mt-0.5">→</span>
              <span>Ceux qui veulent un outil simple et complet</span>
            </li>
          </ul>
        </div>
        <div class="glass p-6 rounded-2xl">
          <h3 class="font-bold text-red-400 mb-4">❌ Moins adapté si</h3>
          <ul class="space-y-2 text-gray-300 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-red-400 mt-0.5">→</span>
              <span>Vous avez besoin de compta avancée (regardez Pennylane)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-400 mt-0.5">→</span>
              <span>Vous voulez un CRM très avancé (regardez Sellsy)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-400 mt-0.5">→</span>
              <span>Vous êtes auto-entrepreneur avec peu de factures (regardez Tiime gratuit)</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Verdict -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-4">🏆 Notre verdict</h2>
      <div class="glass p-6 rounded-2xl border border-purple-500/30">
        <div class="flex items-center gap-4 mb-4">
          <span class="text-4xl">💎</span>
          <div>
            <p class="font-bold text-lg">Le meilleur rapport qualité-prix</p>
            <p class="text-gray-400">Tout-en-un sans se ruiner</p>
          </div>
        </div>
        <p class="text-gray-300 mb-4">
          Axonaut est <span class="text-white font-medium">le couteau suisse des TPE/PME françaises</span>. Un seul outil pour tout gérer : prospects, devis, factures, projets, trésorerie. Et à 34,99€/mois pour toute l'équipe, c'est imbattable.
        </p>
        <p class="text-gray-300">
          <span class="text-gold">Le plus :</span> Support français réactif et interface vraiment simple à prendre en main.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <div class="glass p-8 rounded-2xl border border-gold/30 text-center">
      <p class="text-sm text-gray-400 mb-2">Offre spéciale</p>
      <p class="text-2xl font-bold mb-1">-50% → 34,99€/mois</p>
      <p class="text-gray-400 mb-6">15 jours d'essai gratuit sans CB</p>
      <a href="https://axonaut.com/" target="_blank" rel="noopener" class="inline-block bg-gold text-gray-900 px-10 py-4 rounded-xl font-bold text-lg hover:opacity-90 transition">
        Essayer Axonaut gratuitement →
      </a>
      <p class="text-sm text-gray-500 mt-4">✓ Sans engagement • ✓ Conforme réforme 2026</p>
    </div>

    <!-- Alternatives -->
    <section class="mt-10">
      <h2 class="text-xl font-bold mb-4">🔄 Alternatives à considérer</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/avis/pennylane" class="glass p-4 rounded-xl flex items-center gap-4 hover:bg-white/5 transition">
          <img src="https://www.google.com/s2/favicons?domain=pennylane.com&sz=32" alt="Pennylane" class="w-10 h-10 rounded" />
          <div>
            <p class="font-medium">Pennylane</p>
            <p class="text-sm text-gray-400">Compta avancée + comptable • 29€/mois</p>
          </div>
        </a>
        <a href="/avis/sellsy" class="glass p-4 rounded-xl flex items-center gap-4 hover:bg-white/5 transition">
          <img src="https://www.google.com/s2/favicons?domain=sellsy.com&sz=32" alt="Sellsy" class="w-10 h-10 rounded" />
          <div>
            <p class="font-medium">Sellsy</p>
            <p class="text-sm text-gray-400">CRM avancé • 39€/mois/user</p>
          </div>
        </a>
      </div>
    </section>

  </article>
</Layout>
