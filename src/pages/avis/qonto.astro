---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Avis Qonto 2026 - Test Complet Banque Pro" description="Notre avis complet sur Qonto : la meilleure néobanque pro ? Fonctionnalités, prix, cartes, avantages et inconvénients.">
  <article class="max-w-3xl mx-auto px-4 py-12">

    <div class="mb-8">
      <a href="/comparatif/compta-finance" class="text-purple-400 hover:text-purple-300 text-sm">← Comparatif Compta & Finance</a>
    </div>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-4 mb-4">
        <span class="text-5xl">💳</span>
        <div>
          <h1 class="text-3xl font-bold">Avis <span class="gradient-text">Qonto</span> 2026</h1>
          <p class="text-gray-400">La néobanque préférée des entreprises françaises</p>
        </div>
      </div>
      <div class="flex items-center gap-4 mt-4">
        <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-lg">⭐ 4.7/5</span>
        <span class="bg-gold text-gray-900 px-3 py-1 rounded-lg font-medium">1 mois offert</span>
      </div>
    </header>

    <!-- Résumé rapide -->
    <div class="glass p-6 rounded-2xl border border-gold/30 mb-8">
      <h2 class="font-bold text-lg mb-3">📋 En bref</h2>
      <p class="text-gray-300 mb-4">
        Qonto est la <span class="text-gold">néobanque #1 en France</span> pour les entreprises (500 000+ clients). Ouverture rapide, interface moderne, cartes incluses, parfait pour les indépendants et PME.
      </p>
      <div class="flex flex-wrap gap-4">
        <div>
          <span class="text-gray-500 text-sm">Prix</span>
          <p class="font-medium">À partir de 9€/mois</p>
        </div>
        <div>
          <span class="text-gray-500 text-sm">Ouverture</span>
          <p class="font-medium">100% en ligne, 10 min</p>
        </div>
        <div>
          <span class="text-gray-500 text-sm">Idéal pour</span>
          <p class="font-medium">Freelances, SASU, PME</p>
        </div>
      </div>
    </div>

    <!-- Avantages / Inconvénients -->
    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="glass p-6 rounded-2xl">
        <h3 class="font-bold text-green-400 mb-4">✅ Avantages</h3>
        <ul class="space-y-2 text-gray-300 text-sm">
          <li>• Ouverture 100% en ligne en 10 minutes</li>
          <li>• Interface très claire et moderne</li>
          <li>• Cartes Mastercard incluses</li>
          <li>• Intégrations comptables (Pennylane, etc.)</li>
          <li>• Multi-utilisateurs facile</li>
          <li>• Support réactif (chat)</li>
          <li>• Virements instantanés inclus</li>
        </ul>
      </div>
      <div class="glass p-6 rounded-2xl">
        <h3 class="font-bold text-red-400 mb-4">❌ Inconvénients</h3>
        <ul class="space-y-2 text-gray-300 text-sm">
          <li>• Pas de crédit (ce n'est pas une banque)</li>
          <li>• Pas de dépôt d'espèces</li>
          <li>• Pas de chéquier</li>
          <li>• Limites de retraits selon forfait</li>
        </ul>
      </div>
    </div>

    <!-- Tarifs -->
    <section class="mb-8">
      <h2 class="text-2xl font-bold mb-4">💰 Tarifs Qonto</h2>
      <div class="glass p-6 rounded-2xl">
        <div class="space-y-4">
          <div class="flex justify-between items-center py-3 border-b border-white/10">
            <div>
              <p class="font-medium">Basic</p>
              <p class="text-sm text-gray-400">1 utilisateur, 1 carte, 20 virements/mois</p>
            </div>
            <p class="text-gold font-bold">9€/mois</p>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-white/10">
            <div>
              <p class="font-medium">Smart</p>
              <p class="text-sm text-gray-400">2 utilisateurs, 2 cartes, virements illimités</p>
            </div>
            <p class="text-gold font-bold">19€/mois</p>
          </div>
          <div class="flex justify-between items-center py-3 border-b border-white/10">
            <div>
              <p class="font-medium">Premium</p>
              <p class="text-sm text-gray-400">5 utilisateurs, 5 cartes, fonctions avancées</p>
            </div>
            <p class="text-gold font-bold">39€/mois</p>
          </div>
          <div class="flex justify-between items-center py-3">
            <div>
              <p class="font-medium">Essential (Freelance)</p>
              <p class="text-sm text-gray-400">Pour auto-entrepreneurs</p>
            </div>
            <p class="text-gold font-bold">Gratuit</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Fonctionnalités -->
    <section class="mb-8">
      <h2 class="text-2xl font-bold mb-4">🔧 Ce qui est inclus</h2>
      <div class="glass p-6 rounded-2xl">
        <div class="grid md:grid-cols-2 gap-4">
          <div class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <div>
              <p class="font-medium">IBAN français</p>
              <p class="text-sm text-gray-400">Compte pro en France</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <div>
              <p class="font-medium">Cartes Mastercard</p>
              <p class="text-sm text-gray-400">Physiques et virtuelles</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <div>
              <p class="font-medium">Virements SEPA</p>
              <p class="text-sm text-gray-400">Instantanés disponibles</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-gold">✓</span>
            <div>
              <p class="font-medium">Export comptable</p>
              <p class="text-sm text-gray-400">Connexion Pennylane, etc.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Notre verdict -->
    <section class="mb-8">
      <h2 class="text-2xl font-bold mb-4">🏆 Notre verdict</h2>
      <div class="glass p-6 rounded-2xl">
        <p class="text-gray-300 mb-4">
          Qonto est la <strong class="text-white">meilleure néobanque pro en France</strong>. L'ouverture est ultra-rapide, l'interface est un modèle, et les intégrations comptables font gagner un temps fou.
        </p>
        <p class="text-gray-300">
          <span class="text-gold">Parfait pour :</span> Freelances, auto-entrepreneurs, SASU, startups. Moins adapté si vous avez besoin de crédit ou de chéquier.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <div class="glass p-6 rounded-2xl border border-gold/30 text-center">
      <p class="text-xl font-bold mb-2">🎁 1 mois offert</p>
      <p class="text-gray-300 mb-4">Ouvrez votre compte en 10 minutes</p>
      <a href="https://qonto.com/" target="_blank" rel="noopener" class="inline-block bg-gold text-gray-900 px-8 py-3 rounded-xl font-bold hover:opacity-90 transition">
        Ouvrir un compte Qonto →
      </a>
      <p class="text-sm text-gray-500 mt-3">Inscription 100% en ligne, sans frais cachés</p>
    </div>

  </article>
</Layout>
