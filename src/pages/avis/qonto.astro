---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Avis Qonto 2026 - Test Complet Banque Pro" description="Notre avis complet sur Qonto : la meilleure néobanque pro ? Fonctionnalités, prix, cartes, avantages et inconvénients.">
  <article class="max-w-4xl mx-auto px-4 py-12">

    <div class="mb-8">
      <a href="/comparatif/compta-finance" class="text-purple-400 hover:text-purple-300 text-sm">← Comparatif Compta & Finance</a>
    </div>

    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-4 mb-4">
        <img src="https://www.google.com/s2/favicons?domain=qonto.com&sz=64" alt="Qonto" class="w-16 h-16 rounded-xl" />
        <div>
          <h1 class="text-3xl font-bold">Avis <span class="gradient-text">Qonto</span> 2026</h1>
          <p class="text-gray-400">La néobanque préférée des entreprises françaises</p>
        </div>
      </div>
      <div class="flex items-center gap-3 mt-4">
        <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-lg font-bold">⭐ 4.7/5</span>
        <span class="bg-blue-500/20 text-blue-400 px-3 py-1 rounded-lg text-sm">500 000+ clients</span>
        <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-lg text-sm">Promo bientôt</span>
      </div>
    </header>

    <!-- Résumé rapide -->
    <div class="glass p-6 rounded-2xl border border-gold/30 mb-8">
      <h2 class="font-bold text-lg mb-3">📋 En bref</h2>
      <p class="text-gray-300 mb-4">
        Qonto est la <span class="text-gold">néobanque #1 en France</span> pour les entreprises (500 000+ clients). Ouverture rapide, interface moderne, cartes incluses, parfait pour les indépendants et PME.
      </p>
      <div class="flex flex-wrap gap-6">
        <div>
          <span class="text-gray-500 text-sm">Prix</span>
          <p class="font-bold text-xl">9€<span class="text-gray-400 text-sm font-normal">/mois</span></p>
        </div>
        <div>
          <span class="text-gray-500 text-sm">Ouverture</span>
          <p class="font-medium">100% en ligne, 10 min</p>
        </div>
        <div>
          <span class="text-gray-500 text-sm">Cible</span>
          <p class="font-medium">Freelances, SASU, PME</p>
        </div>
      </div>
    </div>

    <!-- Avantages / Inconvénients -->
    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="glass p-6 rounded-2xl">
        <h3 class="font-bold text-green-400 mb-4">✅ Avantages</h3>
        <ul class="space-y-2 text-gray-300 text-sm">
          <li>• Ouverture 100% en ligne en 10 minutes</li>
          <li>• Interface très claire et moderne</li>
          <li>• Cartes Mastercard incluses</li>
          <li>• Intégrations comptables (Pennylane, etc.)</li>
          <li>• Multi-utilisateurs facile</li>
          <li>• Support réactif (chat)</li>
        </ul>
      </div>
      <div class="glass p-6 rounded-2xl">
        <h3 class="font-bold text-red-400 mb-4">❌ Inconvénients</h3>
        <ul class="space-y-2 text-gray-300 text-sm">
          <li>• Pas de crédit (ce n'est pas une banque)</li>
          <li>• Pas de dépôt d'espèces</li>
          <li>• Pas de chéquier</li>
          <li>• Limites de retraits selon forfait</li>
        </ul>
      </div>
    </div>

    <!-- VOIR PLUS - Section dépliable -->
    <details class="glass rounded-2xl mb-8 group">
      <summary class="px-6 py-4 cursor-pointer font-bold text-lg hover:text-gold transition flex justify-between items-center">
        📖 Voir la fiche complète
        <span class="text-gray-500 group-open:rotate-180 transition-transform text-xl">▼</span>
      </summary>

      <div class="px-6 pb-6 space-y-8 border-t border-white/10 pt-6">

        <!-- Fiche technique -->
        <section>
          <h3 class="text-xl font-bold mb-4">📋 Fiche technique</h3>
          <div class="glass rounded-xl overflow-hidden">
            <table class="w-full text-sm">
              <tbody class="divide-y divide-white/10">
                <tr>
                  <td class="px-4 py-3 text-gray-400 w-1/3">Éditeur</td>
                  <td class="px-4 py-3 font-medium">Qonto (France - Paris)</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-gray-400">Type</td>
                  <td class="px-4 py-3 font-medium">Néobanque pour professionnels</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-gray-400">Clients</td>
                  <td class="px-4 py-3 font-medium">500 000+ entreprises en Europe</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-gray-400">IBAN</td>
                  <td class="px-4 py-3 font-medium text-green-400">✓ Français (FR76)</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-gray-400">Carte bancaire</td>
                  <td class="px-4 py-3 font-medium">Mastercard Business (physique + virtuelle)</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-gray-400">Apps mobiles</td>
                  <td class="px-4 py-3 font-medium">iOS, Android</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-gray-400">Support</td>
                  <td class="px-4 py-3 font-medium">Chat + Email (en français, 7j/7)</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-gray-400">Virements</td>
                  <td class="px-4 py-3 font-medium">SEPA + Instantanés inclus</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Fonctionnalités -->
        <section>
          <h3 class="text-xl font-bold mb-4">🚀 Fonctionnalités</h3>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="glass p-4 rounded-xl">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl">💳</span>
                <h4 class="font-bold">Cartes illimitées</h4>
              </div>
              <p class="text-gray-400 text-sm">Créez des cartes virtuelles instantanément. Contrôlez les plafonds par carte et par utilisateur.</p>
            </div>
            <div class="glass p-4 rounded-xl">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl">👥</span>
                <h4 class="font-bold">Multi-utilisateurs</h4>
              </div>
              <p class="text-gray-400 text-sm">Ajoutez votre équipe avec des droits personnalisés. Chacun sa carte, un seul compte.</p>
            </div>
            <div class="glass p-4 rounded-xl">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl">📊</span>
                <h4 class="font-bold">Export comptable</h4>
              </div>
              <p class="text-gray-400 text-sm">Connexion directe avec Pennylane, Sage, Cegid. Export automatique des écritures.</p>
            </div>
            <div class="glass p-4 rounded-xl">
              <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl">📱</span>
                <h4 class="font-bold">App mobile</h4>
              </div>
              <p class="text-gray-400 text-sm">Gérez tout depuis votre téléphone : virements, cartes, justificatifs, notifications temps réel.</p>
            </div>
          </div>
        </section>

        <!-- Tarifs -->
        <section>
          <h3 class="text-xl font-bold mb-4">💰 Tarifs</h3>
          <div class="glass rounded-xl overflow-hidden">
            <table class="w-full text-sm">
              <thead class="border-b border-white/10">
                <tr>
                  <th class="px-4 py-3 text-left text-gray-400">Offre</th>
                  <th class="px-4 py-3 text-left text-gray-400">Prix</th>
                  <th class="px-4 py-3 text-left text-gray-400">Inclus</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10">
                <tr>
                  <td class="px-4 py-3 font-medium">Essential (Freelance)</td>
                  <td class="px-4 py-3 text-green-400 font-bold">Gratuit</td>
                  <td class="px-4 py-3 text-gray-300">1 utilisateur, carte virtuelle</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-medium">Basic</td>
                  <td class="px-4 py-3 text-gold font-bold">9€/mois</td>
                  <td class="px-4 py-3 text-gray-300">1 utilisateur, 1 carte, 20 virements</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-medium">Smart</td>
                  <td class="px-4 py-3 font-bold">19€/mois</td>
                  <td class="px-4 py-3 text-gray-300">2 utilisateurs, 2 cartes, virements illimités</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-medium">Premium</td>
                  <td class="px-4 py-3 font-bold">39€/mois</td>
                  <td class="px-4 py-3 text-gray-300">5 utilisateurs, 5 cartes, fonctions avancées</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Pour qui -->
        <section>
          <h3 class="text-xl font-bold mb-4">👥 Pour qui ?</h3>
          <div class="glass p-4 rounded-xl">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <p class="font-medium text-green-400 mb-2">✓ Parfait pour</p>
                <ul class="text-sm text-gray-300 space-y-1">
                  <li>• Freelances et auto-entrepreneurs</li>
                  <li>• Startups et SASU</li>
                  <li>• PME jusqu'à 250 employés</li>
                  <li>• Équipes avec plusieurs cartes</li>
                </ul>
              </div>
              <div>
                <p class="font-medium text-red-400 mb-2">✗ Moins adapté si</p>
                <ul class="text-sm text-gray-300 space-y-1">
                  <li>• Vous avez besoin de crédit</li>
                  <li>• Vous faites des dépôts d'espèces</li>
                  <li>• Vous avez besoin de chéquier</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Alternatives -->
        <section>
          <h3 class="text-xl font-bold mb-4">🔄 Alternatives</h3>
          <div class="grid md:grid-cols-2 gap-4">
            <a href="/avis/shine" class="glass p-4 rounded-xl hover:bg-white/5 transition">
              <div class="flex items-center gap-3">
                <img src="https://www.google.com/s2/favicons?domain=shine.fr&sz=32" alt="Shine" class="w-8 h-8 rounded">
                <div>
                  <p class="font-medium">Shine</p>
                  <p class="text-sm text-gray-400">Plus simple, dès 7,90€/mois</p>
                </div>
              </div>
            </a>
            <a href="/avis/axonaut" class="glass p-4 rounded-xl hover:bg-white/5 transition border border-gold/30">
              <div class="flex items-center gap-3">
                <img src="https://www.google.com/s2/favicons?domain=axonaut.com&sz=32" alt="Axonaut" class="w-8 h-8 rounded">
                <div>
                  <p class="font-medium">Axonaut <span class="text-gold text-xs">Partenaire</span></p>
                  <p class="text-sm text-gray-400">CRM + Facturation tout-en-un</p>
                </div>
              </div>
            </a>
          </div>
        </section>

      </div>
    </details>

    <!-- Verdict -->
    <section class="mb-8">
      <h2 class="text-2xl font-bold mb-4">🏆 Notre verdict</h2>
      <div class="glass p-6 rounded-2xl">
        <p class="text-gray-300 mb-4">
          Qonto est la <strong class="text-white">meilleure néobanque pro en France</strong>. L'ouverture est ultra-rapide, l'interface est un modèle, et les intégrations comptables font gagner un temps fou.
        </p>
        <p class="text-gray-300">
          <span class="text-gold">Parfait pour :</span> Freelances, auto-entrepreneurs, SASU, startups. Moins adapté si vous avez besoin de crédit ou de chéquier.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <div class="glass p-6 rounded-2xl border border-gold/30 text-center">
      <p class="text-xl font-bold mb-2">🎁 1 mois offert</p>
      <p class="text-gray-400 mb-4">Ouvrez votre compte en 10 minutes</p>
      <a href="https://qonto.com/" target="_blank" rel="noopener" class="inline-block bg-gold text-gray-900 px-8 py-3 rounded-xl font-bold hover:opacity-90 transition">
        Ouvrir un compte Qonto →
      </a>
      <p class="text-xs text-gray-500 mt-3">Promo partenaire bientôt disponible</p>
    </div>

  </article>
</Layout>
