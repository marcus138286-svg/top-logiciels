---
import Layout from '../../layouts/Layout.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import tools from '../../data/tools.json';

const avis = [
  // Email Marketing
  { slug: "getresponse", name: "GetResponse", category: "Email Marketing", rating: 4.5, logo: "📧", image: tools["email-marketing"][0].image, promo: "-30%" },
  { slug: "brevo", name: "Brevo", category: "Email Marketing", rating: 4.3, logo: "💌", image: tools["email-marketing"][1].image, promo: "Gratuit" },
  { slug: "activecampaign", name: "ActiveCampaign", category: "Email Marketing", rating: 4.6, logo: "⚡", image: tools["email-marketing"][2].image, promo: "14j gratuits" },
  // CRM
  { slug: "hubspot", name: "HubSpot CRM", category: "CRM", rating: 4.7, logo: "🧡", image: tools["crm"][0].image, promo: "Gratuit" },
  { slug: "pipedrive", name: "Pipedrive", category: "CRM", rating: 4.4, logo: "🎯", image: tools["crm"][1].image, promo: "-20%" },
  // Outils IA
  { slug: "copyai", name: "Copy.ai", category: "Outils IA", rating: 4.1, logo: "📝", image: tools["outils-ia"][0].image, promo: "Gratuit" },
  { slug: "writesonic", name: "Writesonic", category: "Outils IA", rating: 4.4, logo: "✍️", image: tools["outils-ia"][1].image, promo: "10k mots gratuits" },
  { slug: "grammarly", name: "Grammarly", category: "Outils IA", rating: 4.6, logo: "📗", image: tools["outils-ia"][2].image, promo: "Gratuit" },
  { slug: "synthesia", name: "Synthesia", category: "Outils IA", rating: 4.5, logo: "🎬", image: tools["outils-ia"][3].image, promo: "Essai gratuit" },
  { slug: "perplexity", name: "Perplexity", category: "Outils IA", rating: 4.7, logo: "🔍", image: tools["outils-ia"][4].image, promo: "Gratuit" },
  // Compta & Finance
  { slug: "qonto", name: "Qonto", category: "Banque Pro", rating: 4.7, logo: "💳", image: tools["compta-finance"][2].image, promo: "1 mois offert" },
  { slug: "pennylane", name: "Pennylane", category: "Comptabilité", rating: 4.6, logo: "🇫🇷", image: tools["compta-finance"][0].image, promo: "1 mois offert" },
  { slug: "shine", name: "Shine", category: "Banque Freelance", rating: 4.4, logo: "✨", image: tools["compta-finance"][3].image, promo: "2 mois offerts" },
  { slug: "indy", name: "Indy", category: "Comptabilité", rating: 4.5, logo: "🧮", image: tools["compta-finance"][4].image, promo: "14j gratuits" },
  { slug: "quickbooks", name: "QuickBooks", category: "Comptabilité", rating: 4.3, logo: "📊", image: tools["compta-finance"][1].image, promo: "-50%" },
  // VPN
  { slug: "nordvpn", name: "NordVPN", category: "VPN", rating: 4.8, logo: "🛡️", image: tools["vpn"][0].image, promo: "-70%" },
  { slug: "surfshark", name: "Surfshark", category: "VPN", rating: 4.6, logo: "🦈", image: tools["vpn"][1].image, promo: "-80%" },
  { slug: "cyberghost", name: "CyberGhost", category: "VPN", rating: 4.4, logo: "👻", image: tools["vpn"][2].image, promo: "-83%" },
  { slug: "protonvpn", name: "ProtonVPN", category: "VPN", rating: 4.5, logo: "🔐", image: tools["vpn"][3].image, promo: "Gratuit" },
];
---

<Layout title="Tous nos Avis Logiciels SaaS 2026" description="Retrouvez tous nos tests et avis complets sur les meilleurs logiciels SaaS : CRM, email marketing, IA, VPN, comptabilité.">
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">📝 Tous nos <span class="gradient-text">Avis</span></h1>
    <p class="text-gray-400 mb-10">{avis.length} logiciels testés et notés</p>

    <div class="grid md:grid-cols-2 gap-6">
      {avis.map(tool => (
        <a href={`/avis/${tool.slug}`} class="glass p-6 rounded-2xl card-hover group">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-3">
              <ToolLogo name={tool.name} image={tool.image} logo={tool.logo} size="lg" />
              <div>
                <h2 class="font-bold text-lg group-hover:text-gold transition">{tool.name}</h2>
                <p class="text-sm text-gray-500">{tool.category}</p>
              </div>
            </div>
            <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg text-sm">⭐ {tool.rating}/5</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="bg-gold/20 text-gold px-2 py-1 rounded text-sm">{tool.promo}</span>
            <span class="text-gray-500 group-hover:text-gold transition">Lire l'avis →</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-gray-400 mb-4">Besoin d'aide pour choisir ?</p>
      <a href="/" class="inline-block bg-gold text-gray-900 px-6 py-3 rounded-xl font-medium hover:opacity-90 transition">
        Voir nos comparatifs →
      </a>
    </div>
  </section>
</Layout>
