---
import Layout from '../../layouts/Layout.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import tools from '../../data/tools.json';

const category = tools["vpn"];

const slugMap: Record<string, string> = {
  "NordVPN": "nordvpn",
  "Surfshark": "surfshark",
  "CyberGhost": "cyberghost",
  "ProtonVPN": "protonvpn"
};
---

<Layout title="Meilleur VPN 2026 : Comparatif NordVPN vs Surfshark vs CyberGhost" description="Quel VPN choisir en 2026 ? Comparatif complet des meilleurs VPN (NordVPN, Surfshark, CyberGhost, ProtonVPN). Prix dès 2,19€/mois, codes promo exclusifs.">

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">🛡️ Comparatif <span class="gradient-text">VPN</span> 2026</h1>
    <p class="text-gray-400 mb-8">Les meilleurs VPN pour protéger votre vie privée et accéder à tout le contenu</p>

    <div class="overflow-x-auto mb-12">
      <table class="w-full glass rounded-2xl overflow-hidden">
        <thead class="border-b border-white/10">
          <tr>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">VPN</th>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">Prix</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Note</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Promo</th>
            <th class="px-4 py-4 text-right text-gray-400 text-sm">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {category.map(tool => (
            <tr class="hover:bg-white/5 transition">
              <td class="px-4 py-4">
                <a href={`/avis/${slugMap[tool.name]}`} class="flex items-center gap-3 group">
                  <ToolLogo name={tool.name} image={tool.image} logo={tool.logo} size="md" />
                  <div>
                    <div class="font-medium group-hover:text-gold transition">{tool.name}</div>
                    <div class="text-sm text-gray-500">{tool.shortDesc}</div>
                  </div>
                </a>
              </td>
              <td class="px-4 py-4 text-sm">
                {tool.originalPrice ? (
                  <div>
                    <span class="line-through text-gray-500">{tool.originalPrice}</span>
                    <span class="text-green-400 font-bold ml-2">{tool.price}</span>
                  </div>
                ) : (
                  <span class="text-gray-300">{tool.price}</span>
                )}
              </td>
              <td class="px-4 py-4 text-center">
                <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg font-medium text-sm">{tool.rating}/5</span>
              </td>
              <td class="px-4 py-4 text-center">
                <div class="flex flex-col gap-1 items-center">
                  {tool.discount && (
                    <span class="bg-red-500 text-white px-2 py-1 rounded-lg text-sm font-bold">{tool.discount}</span>
                  )}
                  {tool.promoText && (
                    <span class="bg-gold/20 text-gold px-2 py-1 rounded text-xs">{tool.promoText}</span>
                  )}
                </div>
              </td>
              <td class="px-4 py-4 text-right">
                <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-gold text-gray-900 px-5 py-2 rounded-lg text-sm font-medium hover:opacity-90 transition whitespace-nowrap">
                  Voir l'offre
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold mb-6">Analyse détaillée</h2>
    <div class="space-y-6">
      {category.map(tool => (
        <div class="glass p-6 rounded-2xl card-hover">
          <div class="flex items-start justify-between mb-4">
            <a href={`/avis/${slugMap[tool.name]}`} class="flex items-center gap-3 group">
              <ToolLogo name={tool.name} image={tool.image} logo={tool.logo} size="lg" />
              <div>
                <h3 class="text-xl font-bold group-hover:text-gold transition">{tool.name}</h3>
                <p class="text-gray-400">{tool.description}</p>
              </div>
            </a>
            <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-full font-medium">{tool.rating}/5</span>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-4">
            <div>
              <h4 class="font-medium text-green-400 mb-2">✅ Avantages</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.pros.map(pro => <li>• {pro}</li>)}
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-red-400 mb-2">❌ Inconvénients</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.cons.map(con => <li>• {con}</li>)}
              </ul>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-white/10">
            <div class="flex items-center gap-3">
              {tool.originalPrice ? (
                <>
                  <span class="line-through text-gray-500">{tool.originalPrice}</span>
                  <span class="font-bold text-green-400 text-lg">{tool.price}</span>
                  <span class="bg-red-500 text-white px-2 py-1 rounded text-sm font-bold">{tool.discount}</span>
                </>
              ) : (
                <span class="font-medium text-white">{tool.price}</span>
              )}
              {tool.promoText && <span class="text-gold text-sm">+ {tool.promoText}</span>}
            </div>
            <div class="flex gap-3">
              {slugMap[tool.name] && (
                <a href={`/avis/${slugMap[tool.name]}`} class="border border-purple-500/50 text-purple-300 px-4 py-2 rounded-xl text-sm hover:bg-purple-500/20 transition">
                  Lire l'avis
                </a>
              )}
              <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-gold text-gray-900 px-6 py-2 rounded-lg font-medium hover:opacity-90 transition whitespace-nowrap">
                Voir l'offre
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-bold mb-6">❓ Questions Fréquentes sur les VPN</h2>
      <div class="space-y-4">
        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            C'est quoi un VPN et à quoi ça sert ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Un VPN (Virtual Private Network) chiffre votre connexion internet et masque votre adresse IP. Ça protège vos données sur les WiFi publics, vous permet d'accéder aux catalogues Netflix d'autres pays, et préserve votre vie privée en ligne.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            NordVPN ou Surfshark : lequel choisir ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            <a href="/avis/nordvpn" class="text-gold hover:underline">NordVPN</a> est plus rapide avec plus de serveurs. <a href="/avis/surfshark" class="text-gold hover:underline">Surfshark</a> offre des appareils illimités à prix cassé. Pour une famille, Surfshark. Pour la performance pure, NordVPN.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Les VPN gratuits sont-ils fiables ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            La plupart des VPN gratuits vendent vos données ou affichent des pubs. L'exception : <a href="/avis/protonvpn" class="text-gold hover:underline">ProtonVPN</a> offre un plan gratuit fiable (mais limité en vitesse). Pour un usage sérieux, investissez 2-3€/mois dans un VPN premium.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Un VPN ralentit-il ma connexion ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Légèrement oui, car vos données sont chiffrées et transitent par un serveur. Mais les VPN modernes comme NordVPN ou Surfshark perdent moins de 10% de débit. Vous ne remarquerez aucune différence pour Netflix ou le web classique.
          </div>
        </details>
      </div>
    </section>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "C'est quoi un VPN et à quoi ça sert ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Un VPN (Virtual Private Network) chiffre votre connexion internet et masque votre adresse IP. Ça protège vos données sur les WiFi publics, vous permet d'accéder aux catalogues Netflix d'autres pays, et préserve votre vie privée en ligne."
        }
      },
      {
        "@type": "Question",
        "name": "NordVPN ou Surfshark : lequel choisir ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "NordVPN est plus rapide avec plus de serveurs. Surfshark offre des appareils illimités à prix cassé. Pour une famille, Surfshark. Pour la performance pure, NordVPN."
        }
      },
      {
        "@type": "Question",
        "name": "Les VPN gratuits sont-ils fiables ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La plupart des VPN gratuits vendent vos données ou affichent des pubs. L'exception : ProtonVPN offre un plan gratuit fiable (mais limité en vitesse). Pour un usage sérieux, investissez 2-3€/mois dans un VPN premium."
        }
      },
      {
        "@type": "Question",
        "name": "Un VPN ralentit-il ma connexion ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Légèrement oui, car vos données sont chiffrées et transitent par un serveur. Mais les VPN modernes comme NordVPN ou Surfshark perdent moins de 10% de débit. Vous ne remarquerez aucune différence pour Netflix ou le web classique."
        }
      }
    ]
  })} />
</Layout>
