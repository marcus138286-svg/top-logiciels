---
import Layout from '../../layouts/Layout.astro';
import tools from '../../data/tools.json';

const category = tools["outils-ia"];
---

<Layout title="Comparatif Outils IA 2026 - Meilleurs Logiciels" description="Comparatif des meilleurs outils IA : Jasper, Copy.ai, ChatGPT. Prix, fonctionnalités et codes promo.">

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">🤖 Comparatif Outils IA 2026</h1>
    <p class="text-gray-600 mb-8">Les meilleurs assistants IA pour la rédaction et la productivité</p>

    <div class="overflow-x-auto mb-12">
      <table class="w-full bg-white rounded-xl shadow-sm border">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left">Logiciel</th>
            <th class="px-4 py-3 text-left">Prix</th>
            <th class="px-4 py-3 text-center">Note</th>
            <th class="px-4 py-3 text-center">Promo</th>
            <th class="px-4 py-3 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          {category.map(tool => (
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-4">
                <div class="flex items-center gap-3">
                  <span class="text-2xl">{tool.logo}</span>
                  <div>
                    <div class="font-medium">{tool.name}</div>
                    <div class="text-sm text-gray-500">{tool.shortDesc}</div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-4 text-sm">{tool.price}</td>
              <td class="px-4 py-4 text-center">
                <span class="bg-green-100 text-green-800 px-2 py-1 rounded font-medium">{tool.rating}/5</span>
              </td>
              <td class="px-4 py-4 text-center">
                {tool.promoText ? (
                  <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-sm">{tool.promoText}</span>
                ) : (
                  <span class="text-gray-400">-</span>
                )}
              </td>
              <td class="px-4 py-4 text-right">
                <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm hover:bg-blue-700">
                  Essayer →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold mb-6">Analyse détaillée</h2>
    <div class="space-y-8">
      {category.map(tool => (
        <div class="bg-white p-6 rounded-xl border shadow-sm">
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <span class="text-3xl">{tool.logo}</span>
              <div>
                <h3 class="text-xl font-bold">{tool.name}</h3>
                <p class="text-gray-600">{tool.description}</p>
              </div>
            </div>
            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full font-medium">{tool.rating}/5</span>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-4">
            <div>
              <h4 class="font-medium text-green-700 mb-2">✅ Avantages</h4>
              <ul class="text-sm space-y-1">
                {tool.pros.map(pro => <li>• {pro}</li>)}
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-red-700 mb-2">❌ Inconvénients</h4>
              <ul class="text-sm space-y-1">
                {tool.cons.map(con => <li>• {con}</li>)}
              </ul>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t">
            <div>
              <span class="text-gray-600">Prix : </span>
              <span class="font-medium">{tool.price}</span>
              {tool.promoText && <span class="ml-2 text-green-600 text-sm">({tool.promoText})</span>}
            </div>
            <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-medium hover:bg-blue-700">
              Essayer {tool.name} →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
