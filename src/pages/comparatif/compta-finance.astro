---
import Layout from '../../layouts/Layout.astro';
import tools from '../../data/tools.json';

const category = tools["compta-finance"];

const slugMap: Record<string, string> = {
  "Pennylane": "pennylane",
  "QuickBooks": "quickbooks",
  "Qonto": "qonto",
  "Shine": "shine",
  "Indy (ex-Georges)": "indy"
};
---

<Layout title="Comparatif Comptabilité & Banque Pro 2026" description="Comparatif des meilleurs logiciels de comptabilité et banques pro : Pennylane, QuickBooks, Qonto, Shine. Prix et codes promo.">

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">💰 Comparatif <span class="gradient-text">Compta & Finance</span> Pro 2026</h1>
    <p class="text-gray-400 mb-8">Les meilleurs outils pour gérer votre comptabilité et vos finances pro</p>

    <div class="overflow-x-auto mb-12">
      <table class="w-full glass rounded-2xl overflow-hidden">
        <thead class="border-b border-white/10">
          <tr>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">Logiciel</th>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">Prix</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Note</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Promo</th>
            <th class="px-4 py-4 text-right text-gray-400 text-sm">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {category.map(tool => (
            <tr class="hover:bg-white/5 transition">
              <td class="px-4 py-4">
                <div class="flex items-center gap-3">
                  <span class="text-2xl">{tool.logo}</span>
                  <div>
                    <div class="font-medium">{tool.name}</div>
                    <div class="text-sm text-gray-500">{tool.shortDesc}</div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-4 text-sm text-gray-300">{tool.price}</td>
              <td class="px-4 py-4 text-center">
                <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg font-medium text-sm">{tool.rating}/5</span>
              </td>
              <td class="px-4 py-4 text-center">
                {tool.promoText ? (
                  <span class="bg-gold text-gray-900 px-2 py-1 rounded-lg text-sm font-medium">{tool.promoText}</span>
                ) : (
                  <span class="text-gray-600">-</span>
                )}
              </td>
              <td class="px-4 py-4 text-right">
                <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-purple-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-purple-700 transition">
                  Essayer →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold mb-6">Analyse détaillée</h2>
    <div class="space-y-6">
      {category.map(tool => (
        <div class="glass p-6 rounded-2xl card-hover">
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <span class="text-3xl">{tool.logo}</span>
              <div>
                <h3 class="text-xl font-bold">{tool.name}</h3>
                <p class="text-gray-400">{tool.description}</p>
              </div>
            </div>
            <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-full font-medium">{tool.rating}/5</span>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-4">
            <div>
              <h4 class="font-medium text-green-400 mb-2">✅ Avantages</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.pros.map(pro => <li>• {pro}</li>)}
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-red-400 mb-2">❌ Inconvénients</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.cons.map(con => <li>• {con}</li>)}
              </ul>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-white/10">
            <div>
              <span class="text-gray-500">Prix : </span>
              <span class="font-medium text-white">{tool.price}</span>
              {tool.promoText && <span class="ml-2 text-gold text-sm">({tool.promoText})</span>}
            </div>
            <div class="flex gap-3">
              {slugMap[tool.name] && (
                <a href={`/avis/${slugMap[tool.name]}`} class="border border-purple-500/50 text-purple-300 px-4 py-2 rounded-xl text-sm hover:bg-purple-500/20 transition">
                  Lire l'avis
                </a>
              )}
              <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-gold text-gray-900 px-6 py-2 rounded-xl font-medium hover:opacity-90 transition">
                Essayer →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-bold mb-6">❓ Questions Fréquentes</h2>
      <div class="space-y-4">
        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Faut-il un compte bancaire pro quand on est freelance ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            C'est obligatoire dès que votre CA dépasse 10 000€/an pendant 2 années consécutives (micro-entreprise). Mais même avant, c'est fortement recommandé pour séparer vos finances perso et pro. <a href="/avis/shine" class="text-gold hover:underline">Shine</a> et <a href="/avis/qonto" class="text-gold hover:underline">Qonto</a> sont les meilleures options.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Logiciel compta vs expert-comptable : que choisir ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            En micro-entreprise, un logiciel comme <a href="/avis/indy" class="text-gold hover:underline">Indy</a> suffit amplement. En société (SASU, EURL...), combinez un logiciel avec un expert-comptable. <a href="/avis/pennylane" class="text-gold hover:underline">Pennylane</a> facilite justement cette collaboration.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Shine ou Qonto : lequel est le mieux ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            <a href="/avis/shine" class="text-gold hover:underline">Shine</a> est parfait pour les freelances solo (conseils admin inclus, interface simple). <a href="/avis/qonto" class="text-gold hover:underline">Qonto</a> convient mieux aux TPE/PME (multi-utilisateurs, cartes équipe, intégrations).
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Comment automatiser ma déclaration URSSAF ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            <a href="/avis/indy" class="text-gold hover:underline">Indy</a> (ex-Georges) pré-remplit automatiquement votre déclaration URSSAF en analysant vos transactions. Vous n'avez qu'à valider. C'est le meilleur outil pour les indépendants qui veulent gagner du temps sur l'administratif.
          </div>
        </details>
      </div>
    </section>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Faut-il un compte bancaire pro quand on est freelance ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "C'est obligatoire dès que votre CA dépasse 10 000€/an pendant 2 années consécutives (micro-entreprise). Mais même avant, c'est fortement recommandé pour séparer vos finances perso et pro. Shine et Qonto sont les meilleures options."
        }
      },
      {
        "@type": "Question",
        "name": "Logiciel compta vs expert-comptable : que choisir ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "En micro-entreprise, un logiciel comme Indy suffit amplement. En société (SASU, EURL...), combinez un logiciel avec un expert-comptable. Pennylane facilite justement cette collaboration."
        }
      },
      {
        "@type": "Question",
        "name": "Shine ou Qonto : lequel est le mieux ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Shine est parfait pour les freelances solo (conseils admin inclus, interface simple). Qonto convient mieux aux TPE/PME (multi-utilisateurs, cartes équipe, intégrations)."
        }
      },
      {
        "@type": "Question",
        "name": "Comment automatiser ma déclaration URSSAF ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Indy (ex-Georges) pré-remplit automatiquement votre déclaration URSSAF en analysant vos transactions. Vous n'avez qu'à valider. C'est le meilleur outil pour les indépendants qui veulent gagner du temps sur l'administratif."
        }
      }
    ]
  })} />
</Layout>
