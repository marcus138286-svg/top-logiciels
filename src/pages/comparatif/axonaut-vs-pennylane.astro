---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Axonaut vs Pennylane 2026 : Quel logiciel choisir ?" description="Comparatif détaillé Axonaut vs Pennylane : prix, fonctionnalités, conformité 2026. Découvrez lequel est fait pour vous.">
  <article class="max-w-5xl mx-auto px-4 py-12">

    <div class="mb-8">
      <a href="/comparatif/facturation" class="text-purple-400 hover:text-purple-300 text-sm">← Comparatif Facturation</a>
    </div>

    <!-- Header -->
    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="text-gold">Axonaut</span> vs <span class="gradient-text">Pennylane</span>
      </h1>
      <p class="text-xl text-gray-400">Le match 2026 des deux champions français</p>
    </header>

    <!-- Quick verdict -->
    <div class="glass p-6 rounded-2xl border border-purple-500/30 mb-10">
      <h2 class="font-bold text-lg mb-4 text-center">⚡ En 30 secondes</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="text-center">
          <img src="https://www.google.com/s2/favicons?domain=axonaut.com&sz=48" alt="Axonaut" class="w-12 h-12 mx-auto mb-2 rounded-lg" />
          <p class="font-bold text-gold">Axonaut</p>
          <p class="text-sm text-gray-400 mb-2">Si vous voulez tout-en-un sans comptable</p>
          <p class="text-green-400 font-bold">34,99€/mois</p>
        </div>
        <div class="text-center">
          <img src="https://www.google.com/s2/favicons?domain=pennylane.com&sz=48" alt="Pennylane" class="w-12 h-12 mx-auto mb-2 rounded-lg" />
          <p class="font-bold text-purple-400">Pennylane</p>
          <p class="text-sm text-gray-400 mb-2">Si vous travaillez avec un expert-comptable</p>
          <p class="font-bold">29€/mois</p>
        </div>
      </div>
    </div>

    <!-- Tableau comparatif -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">📊 Comparatif détaillé</h2>
      <div class="glass rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
          <thead class="border-b border-white/10 bg-white/5">
            <tr>
              <th class="px-4 py-4 text-left text-gray-400">Critère</th>
              <th class="px-4 py-4 text-center">
                <img src="https://www.google.com/s2/favicons?domain=axonaut.com&sz=24" alt="" class="w-6 h-6 mx-auto mb-1 rounded" />
                <span class="text-gold">Axonaut</span>
              </th>
              <th class="px-4 py-4 text-center">
                <img src="https://www.google.com/s2/favicons?domain=pennylane.com&sz=24" alt="" class="w-6 h-6 mx-auto mb-1 rounded" />
                <span class="text-purple-400">Pennylane</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            <tr>
              <td class="px-4 py-3 text-gray-300">Prix de base</td>
              <td class="px-4 py-3 text-center font-bold text-green-400">34,99€/mois</td>
              <td class="px-4 py-3 text-center font-bold">29€/mois</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Utilisateurs inclus</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">Illimités ✓</td>
              <td class="px-4 py-3 text-center">1 (puis +10€/user)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">CRM intégré</td>
              <td class="px-4 py-3 text-center text-green-400">✓ Complet</td>
              <td class="px-4 py-3 text-center text-red-400">✗ Non</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Facturation</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Comptabilité avancée</td>
              <td class="px-4 py-3 text-center">Basique</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ Complète</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Connexion bancaire</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ 300+ banques</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Collaboration comptable</td>
              <td class="px-4 py-3 text-center">Export manuel</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ Temps réel</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Gestion de projets</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
              <td class="px-4 py-3 text-center text-red-400">✗</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Notes de frais</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Conforme 2026</td>
              <td class="px-4 py-3 text-center text-green-400">✓ DGFiP</td>
              <td class="px-4 py-3 text-center text-green-400">✓ DGFiP</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Support</td>
              <td class="px-4 py-3 text-center">FR (Chat, Tel)</td>
              <td class="px-4 py-3 text-center">FR (Chat, Tel)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Essai gratuit</td>
              <td class="px-4 py-3 text-center">15 jours</td>
              <td class="px-4 py-3 text-center">1 mois offert</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Choisir Axonaut si -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">🎯 Choisissez Axonaut si...</h2>
      <div class="glass p-6 rounded-2xl border border-gold/30">
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous voulez <strong class="text-white">un seul outil pour tout</strong> (CRM + Devis + Factures + Gestion)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous n'avez <strong class="text-white">pas d'expert-comptable</strong> ou voulez vous en passer</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous avez <strong class="text-white">une équipe</strong> (utilisateurs illimités sans surcoût)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous gérez des <strong class="text-white">projets</strong> et voulez suivre leur rentabilité</span>
          </li>
        </ul>
        <div class="mt-6 text-center">
          <a href="https://axonaut.com/?a=B518CH1408" target="_blank" rel="noopener" class="inline-block bg-gold text-gray-900 px-8 py-3 rounded-xl font-bold hover:opacity-90 transition">
            Essayer Axonaut (-50%) →
          </a>
        </div>
      </div>
    </section>

    <!-- Choisir Pennylane si -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">📊 Choisissez Pennylane si...</h2>
      <div class="glass p-6 rounded-2xl border border-purple-500/30">
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">Vous travaillez avec un <strong class="text-white">expert-comptable</strong></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">La <strong class="text-white">comptabilité automatisée</strong> est votre priorité</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">Vous avez <strong class="text-white">beaucoup de transactions bancaires</strong> à réconcilier</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">Vous avez déjà un CRM et cherchez <strong class="text-white">uniquement la compta/facturation</strong></span>
          </li>
        </ul>
        <div class="mt-6 text-center">
          <a href="https://www.pennylane.com/" target="_blank" rel="noopener" class="inline-block bg-purple-600 text-white px-8 py-3 rounded-xl font-bold hover:opacity-90 transition">
            Essayer Pennylane →
          </a>
        </div>
      </div>
    </section>

    <!-- Notre recommandation -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">🏆 Notre recommandation</h2>
      <div class="glass p-6 rounded-2xl">
        <div class="flex items-start gap-4 mb-4">
          <span class="text-4xl">💡</span>
          <div>
            <p class="font-bold text-lg mb-2">Pour la majorité des TPE/PME : Axonaut</p>
            <p class="text-gray-300">
              Si vous cherchez <strong class="text-white">un outil tout-en-un</strong> pour gérer votre activité sans dépendre d'un comptable, Axonaut est imbattable. Le prix unique avec utilisateurs illimités est un énorme avantage pour les équipes.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-4xl">📈</span>
          <div>
            <p class="font-bold text-lg mb-2">Si la compta est centrale : Pennylane</p>
            <p class="text-gray-300">
              Pour les entreprises qui ont <strong class="text-white">beaucoup de flux financiers</strong> et veulent une comptabilité automatisée avec leur expert-comptable, Pennylane est supérieur.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">❓ Questions fréquentes</h2>
      <div class="space-y-4">
        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Peut-on migrer de l'un vers l'autre ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Oui, les deux proposent des imports de données. Le plus simple est d'exporter vos contacts et factures en CSV depuis l'ancien outil et de les importer dans le nouveau. Comptez quelques heures de travail.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Les deux sont-ils conformes à la réforme 2026 ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Oui, Axonaut et Pennylane sont tous deux immatriculés par la DGFiP comme Plateformes de Dématérialisation Partenaires (PDP). Vos factures seront automatiquement au format Factur-X.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Lequel a le meilleur support ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Les deux ont un excellent support en français. Axonaut est basé à Toulouse, Pennylane à Paris. Les retours utilisateurs sont positifs pour les deux, avec des temps de réponse rapides sur le chat.
          </div>
        </details>
      </div>
    </section>

    <!-- CTA final -->
    <div class="grid md:grid-cols-2 gap-6">
      <a href="/avis/axonaut" class="glass p-6 rounded-2xl border-2 border-gold/50 hover:border-gold transition text-center group">
        <img src="https://www.google.com/s2/favicons?domain=axonaut.com&sz=48" alt="Axonaut" class="w-12 h-12 mx-auto mb-3 rounded-lg" />
        <p class="font-bold text-lg group-hover:text-gold transition">Voir l'avis Axonaut</p>
        <p class="text-sm text-gray-400">Fiche complète + essai gratuit</p>
      </a>
      <a href="/avis/pennylane" class="glass p-6 rounded-2xl border border-purple-500/30 hover:border-purple-500 transition text-center group">
        <img src="https://www.google.com/s2/favicons?domain=pennylane.com&sz=48" alt="Pennylane" class="w-12 h-12 mx-auto mb-3 rounded-lg" />
        <p class="font-bold text-lg group-hover:text-purple-400 transition">Voir l'avis Pennylane</p>
        <p class="text-sm text-gray-400">Fiche complète + essai gratuit</p>
      </a>
    </div>

  </article>
</Layout>
