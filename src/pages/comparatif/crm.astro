---
import Layout from '../../layouts/Layout.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import tools from '../../data/tools.json';

const category = tools["crm"];

const slugMap: Record<string, string> = {
  "HubSpot CRM": "hubspot",
  "Pipedrive": "pipedrive"
};
---

<Layout title="Meilleur CRM Gratuit 2026 : HubSpot vs Pipedrive (Comparatif)" description="Quel CRM choisir pour gérer vos clients ? Comparatif HubSpot (gratuit) vs Pipedrive. Fonctionnalités, tarifs et 14 jours d'essai gratuit inclus.">

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">👥 Comparatif <span class="gradient-text">CRM</span> 2026</h1>
    <p class="text-xl text-gray-300 mb-2">Logiciels de Gestion de la Relation Client</p>
    <p class="text-gray-400 mb-8">Les meilleurs outils CRM pour centraliser vos contacts, suivre vos prospects et booster vos ventes</p>

    <div class="overflow-x-auto mb-12">
      <table class="w-full glass rounded-2xl overflow-hidden">
        <thead class="border-b border-white/10">
          <tr>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">Logiciel</th>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">Prix</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Note</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Promo</th>
            <th class="px-4 py-4 text-right text-gray-400 text-sm">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {category.map(tool => (
            <tr class="hover:bg-white/5 transition">
              <td class="px-4 py-4">
                <a href={`/avis/${slugMap[tool.name]}`} class="flex items-center gap-3 group">
                  <ToolLogo name={tool.name} image={tool.image} logo={tool.logo} size="md" />
                  <div>
                    <div class="font-medium group-hover:text-gold transition">{tool.name}</div>
                    <div class="text-sm text-gray-500">{tool.shortDesc}</div>
                  </div>
                </a>
              </td>
              <td class="px-4 py-4 text-sm">
                {tool.originalPrice ? (
                  <div>
                    <span class="line-through text-gray-500">{tool.originalPrice}</span>
                    <span class="text-green-400 font-bold ml-2">{tool.price}</span>
                  </div>
                ) : (
                  <span class="text-gray-300">{tool.price}</span>
                )}
              </td>
              <td class="px-4 py-4 text-center">
                <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg font-medium text-sm">{tool.rating}/5</span>
              </td>
              <td class="px-4 py-4 text-center">
                <div class="flex flex-col gap-1 items-center">
                  {tool.discount && (
                    <span class="bg-red-500 text-white px-2 py-1 rounded-lg text-sm font-bold">{tool.discount}</span>
                  )}
                  {tool.promoText && (
                    <span class="bg-gold/20 text-gold px-2 py-1 rounded text-xs">{tool.promoText}</span>
                  )}
                </div>
              </td>
              <td class="px-4 py-4 text-right">
                <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-gold text-gray-900 px-5 py-2 rounded-lg text-sm font-medium hover:opacity-90 transition whitespace-nowrap">
                  Voir l'offre
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold mb-6">Analyse détaillée</h2>
    <div class="space-y-6">
      {category.map(tool => (
        <div class="glass p-6 rounded-2xl card-hover">
          <div class="flex items-start justify-between mb-4">
            <a href={`/avis/${slugMap[tool.name]}`} class="flex items-center gap-3 group">
              <ToolLogo name={tool.name} image={tool.image} logo={tool.logo} size="lg" />
              <div>
                <h3 class="text-xl font-bold group-hover:text-gold transition">{tool.name}</h3>
                <p class="text-gray-400">{tool.description}</p>
              </div>
            </a>
            <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-full font-medium">{tool.rating}/5</span>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-4">
            <div>
              <h4 class="font-medium text-green-400 mb-2">✅ Avantages</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.pros.map(pro => <li>• {pro}</li>)}
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-red-400 mb-2">❌ Inconvénients</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.cons.map(con => <li>• {con}</li>)}
              </ul>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-white/10">
            <div class="flex items-center gap-3">
              {tool.originalPrice ? (
                <>
                  <span class="line-through text-gray-500">{tool.originalPrice}</span>
                  <span class="font-bold text-green-400 text-lg">{tool.price}</span>
                  <span class="bg-red-500 text-white px-2 py-1 rounded text-sm font-bold">{tool.discount}</span>
                </>
              ) : (
                <span class="font-medium text-white">{tool.price}</span>
              )}
              {tool.promoText && <span class="text-gold text-sm">+ {tool.promoText}</span>}
            </div>
            <div class="flex gap-3">
              {slugMap[tool.name] && (
                <a href={`/avis/${slugMap[tool.name]}`} class="border border-purple-500/50 text-purple-300 px-4 py-2 rounded-xl text-sm hover:bg-purple-500/20 transition">
                  Lire l'avis
                </a>
              )}
              <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-gold text-gray-900 px-6 py-2 rounded-xl font-medium hover:opacity-90 transition">
                Voir l'offre
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-bold mb-6">❓ Questions Fréquentes sur les CRM</h2>
      <div class="space-y-4">
        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            C'est quoi un CRM exactement ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            CRM signifie "Customer Relationship Management" ou "Gestion de la Relation Client" en français. C'est un logiciel qui centralise toutes les informations sur vos clients et prospects : coordonnées, historique des échanges, devis, ventes. Ça permet de ne rien oublier et de mieux vendre.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Quel CRM gratuit choisir ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            <a href="/avis/hubspot" class="text-gold hover:underline">HubSpot CRM</a> est le meilleur CRM gratuit du marché. Il est gratuit à vie (pas juste un essai), sans limite de contacts, et très complet. C'est notre recommandation pour débuter sans budget.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            CRM vs Excel : pourquoi changer ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Excel fonctionne pour 10 contacts, mais au-delà c'est ingérable : pas de rappels automatiques, pas d'historique des échanges, pas de pipeline visuel, risque d'erreurs... Un CRM automatise tout ça et vous fait gagner des heures chaque semaine.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            HubSpot ou Pipedrive : lequel choisir ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            <a href="/avis/hubspot" class="text-gold hover:underline">HubSpot</a> si vous débutez ou voulez un outil gratuit avec marketing intégré. <a href="/avis/pipedrive" class="text-gold hover:underline">Pipedrive</a> si vous êtes une équipe commerciale qui veut un outil 100% focalisé sur la vente avec un excellent pipeline visuel.
          </div>
        </details>
      </div>
    </section>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "C'est quoi un CRM exactement ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "CRM signifie Customer Relationship Management ou Gestion de la Relation Client en français. C'est un logiciel qui centralise toutes les informations sur vos clients et prospects : coordonnées, historique des échanges, devis, ventes. Ça permet de ne rien oublier et de mieux vendre."
        }
      },
      {
        "@type": "Question",
        "name": "Quel CRM gratuit choisir ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "HubSpot CRM est le meilleur CRM gratuit du marché. Il est gratuit à vie (pas juste un essai), sans limite de contacts, et très complet. C'est notre recommandation pour débuter sans budget."
        }
      },
      {
        "@type": "Question",
        "name": "CRM vs Excel : pourquoi changer ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Excel fonctionne pour 10 contacts, mais au-delà c'est ingérable : pas de rappels automatiques, pas d'historique des échanges, pas de pipeline visuel, risque d'erreurs... Un CRM automatise tout ça et vous fait gagner des heures chaque semaine."
        }
      },
      {
        "@type": "Question",
        "name": "HubSpot ou Pipedrive : lequel choisir ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "HubSpot si vous débutez ou voulez un outil gratuit avec marketing intégré. Pipedrive si vous êtes une équipe commerciale qui veut un outil 100% focalisé sur la vente avec un excellent pipeline visuel."
        }
      }
    ]
  })} />
</Layout>
