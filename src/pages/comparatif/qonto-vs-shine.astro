---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Qonto vs Shine 2026 : Quelle banque pro choisir ?" description="Comparatif détaillé Qonto vs Shine : prix, cartes, fonctionnalités. Trouvez la meilleure néobanque pour votre entreprise.">
  <article class="max-w-5xl mx-auto px-4 py-12">

    <div class="mb-8">
      <a href="/comparatif/compta-finance" class="text-purple-400 hover:text-purple-300 text-sm">← Comparatif Compta & Finance</a>
    </div>

    <!-- Header -->
    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="gradient-text">Qonto</span> vs <span class="text-gold">Shine</span>
      </h1>
      <p class="text-xl text-gray-400">Le duel des néobanques françaises pour pros</p>
    </header>

    <!-- Quick verdict -->
    <div class="glass p-6 rounded-2xl border border-purple-500/30 mb-10">
      <h2 class="font-bold text-lg mb-4 text-center">⚡ En 30 secondes</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="text-center">
          <img src="https://www.google.com/s2/favicons?domain=qonto.com&sz=48" alt="Qonto" class="w-12 h-12 mx-auto mb-2 rounded-lg" />
          <p class="font-bold text-purple-400">Qonto</p>
          <p class="text-sm text-gray-400 mb-2">Pour les équipes et PME exigeantes</p>
          <p class="font-bold">Dès 9€/mois</p>
        </div>
        <div class="text-center">
          <img src="https://www.google.com/s2/favicons?domain=shine.fr&sz=48" alt="Shine" class="w-12 h-12 mx-auto mb-2 rounded-lg" />
          <p class="font-bold text-gold">Shine</p>
          <p class="text-sm text-gray-400 mb-2">Pour les freelances qui veulent simple</p>
          <p class="text-green-400 font-bold">7,90€/mois</p>
        </div>
      </div>
    </div>

    <!-- Tableau comparatif -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">📊 Comparatif détaillé</h2>
      <div class="glass rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
          <thead class="border-b border-white/10 bg-white/5">
            <tr>
              <th class="px-4 py-4 text-left text-gray-400">Critère</th>
              <th class="px-4 py-4 text-center">
                <img src="https://www.google.com/s2/favicons?domain=qonto.com&sz=24" alt="" class="w-6 h-6 mx-auto mb-1 rounded" />
                <span class="text-purple-400">Qonto</span>
              </th>
              <th class="px-4 py-4 text-center">
                <img src="https://www.google.com/s2/favicons?domain=shine.fr&sz=24" alt="" class="w-6 h-6 mx-auto mb-1 rounded" />
                <span class="text-gold">Shine</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            <tr>
              <td class="px-4 py-3 text-gray-300">Prix de base</td>
              <td class="px-4 py-3 text-center font-bold">9€/mois</td>
              <td class="px-4 py-3 text-center font-bold text-green-400">7,90€/mois</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Offre gratuite</td>
              <td class="px-4 py-3 text-center text-green-400">✓ Essential</td>
              <td class="px-4 py-3 text-center text-red-400">✗</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">IBAN français</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Carte Mastercard</td>
              <td class="px-4 py-3 text-center text-green-400">✓ Incluse</td>
              <td class="px-4 py-3 text-center text-green-400">✓ Incluse</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Cartes virtuelles</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ Illimitées</td>
              <td class="px-4 py-3 text-center">Limitées</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Multi-utilisateurs</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ Avancé</td>
              <td class="px-4 py-3 text-center">Basique</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Virements SEPA</td>
              <td class="px-4 py-3 text-center">20/mois (Basic)</td>
              <td class="px-4 py-3 text-center">20/mois (Start)</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Virements instantanés</td>
              <td class="px-4 py-3 text-center text-green-400">✓ Inclus</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Facturation intégrée</td>
              <td class="px-4 py-3 text-center text-red-400">✗</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ Incluse</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Accompagnement admin</td>
              <td class="px-4 py-3 text-center text-red-400">✗</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ Inclus</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Intégrations comptables</td>
              <td class="px-4 py-3 text-center text-green-400 font-bold">✓ Nombreuses</td>
              <td class="px-4 py-3 text-center text-green-400">✓</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">App mobile</td>
              <td class="px-4 py-3 text-center text-green-400">✓ Excellente</td>
              <td class="px-4 py-3 text-center text-green-400">✓ Très bien</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-gray-300">Support</td>
              <td class="px-4 py-3 text-center">Chat 7j/7</td>
              <td class="px-4 py-3 text-center">Chat + Email</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Choisir Qonto si -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">🎯 Choisissez Qonto si...</h2>
      <div class="glass p-6 rounded-2xl border border-purple-500/30">
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">Vous avez une <strong class="text-white">équipe</strong> qui a besoin de plusieurs cartes</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">Vous êtes une <strong class="text-white">PME ou startup</strong> en croissance</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">Vous avez besoin de <strong class="text-white">cartes virtuelles illimitées</strong> (abonnements SaaS, publicité...)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-purple-400 text-xl">→</span>
            <span class="text-gray-300">Vous voulez des <strong class="text-white">intégrations comptables poussées</strong> (Pennylane, Sage...)</span>
          </li>
        </ul>
        <div class="mt-6 text-center">
          <a href="https://qonto.com/" target="_blank" rel="noopener" class="inline-block bg-purple-600 text-white px-8 py-3 rounded-xl font-bold hover:opacity-90 transition">
            Ouvrir un compte Qonto →
          </a>
        </div>
      </div>
    </section>

    <!-- Choisir Shine si -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">✨ Choisissez Shine si...</h2>
      <div class="glass p-6 rounded-2xl border border-gold/30">
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous êtes <strong class="text-white">freelance ou auto-entrepreneur</strong></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous voulez <strong class="text-white">facturation + compte pro</strong> dans un seul outil</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous débutez et appréciez l'<strong class="text-white">accompagnement administratif</strong></span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-gold text-xl">→</span>
            <span class="text-gray-300">Vous cherchez le <strong class="text-white">meilleur rapport qualité-prix</strong></span>
          </li>
        </ul>
        <div class="mt-6 text-center">
          <a href="https://www.shine.fr/" target="_blank" rel="noopener" class="inline-block bg-gold text-gray-900 px-8 py-3 rounded-xl font-bold hover:opacity-90 transition">
            Ouvrir un compte Shine →
          </a>
        </div>
      </div>
    </section>

    <!-- Notre recommandation -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">🏆 Notre recommandation</h2>
      <div class="glass p-6 rounded-2xl">
        <div class="flex items-start gap-4 mb-4">
          <span class="text-4xl">👤</span>
          <div>
            <p class="font-bold text-lg mb-2">Freelance / Auto-entrepreneur → Shine</p>
            <p class="text-gray-300">
              À 7,90€/mois avec facturation et accompagnement admin inclus, Shine est <strong class="text-white">imbattable pour les solopreneurs</strong>. L'interface est simple et vous êtes accompagné dans vos démarches.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-4xl">👥</span>
          <div>
            <p class="font-bold text-lg mb-2">Équipe / PME → Qonto</p>
            <p class="text-gray-300">
              Dès que vous avez <strong class="text-white">2+ personnes ou des besoins avancés</strong> (multi-cartes, intégrations, API), Qonto devient le choix évident. C'est la référence des PME françaises.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold mb-6">❓ Questions fréquentes</h2>
      <div class="space-y-4">
        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Peut-on avoir les deux ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Oui, certains entrepreneurs utilisent les deux : Shine pour leur micro-entreprise et Qonto pour leur SASU par exemple. Chaque compte a son propre IBAN.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Lequel a le meilleur service client ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Les deux ont un excellent support en français. Shine se distingue par son accompagnement administratif (questions sur les déclarations, statuts...). Qonto a un chat réactif 7j/7.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Sont-ils de vraies banques ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Ce sont des établissements de paiement agréés par l'ACPR/Banque de France, pas des banques traditionnelles. Vos fonds sont protégés mais ils ne proposent pas de crédit ni de découvert (sauf partenariats).
          </div>
        </details>
      </div>
    </section>

    <!-- CTA final -->
    <div class="grid md:grid-cols-2 gap-6">
      <a href="/avis/qonto" class="glass p-6 rounded-2xl border border-purple-500/30 hover:border-purple-500 transition text-center group">
        <img src="https://www.google.com/s2/favicons?domain=qonto.com&sz=48" alt="Qonto" class="w-12 h-12 mx-auto mb-3 rounded-lg" />
        <p class="font-bold text-lg group-hover:text-purple-400 transition">Voir l'avis Qonto</p>
        <p class="text-sm text-gray-400">Fiche complète + essai gratuit</p>
      </a>
      <a href="/avis/shine" class="glass p-6 rounded-2xl border border-gold/30 hover:border-gold transition text-center group">
        <img src="https://www.google.com/s2/favicons?domain=shine.fr&sz=48" alt="Shine" class="w-12 h-12 mx-auto mb-3 rounded-lg" />
        <p class="font-bold text-lg group-hover:text-gold transition">Voir l'avis Shine</p>
        <p class="text-sm text-gray-400">Fiche complète + essai gratuit</p>
      </a>
    </div>

  </article>
</Layout>
