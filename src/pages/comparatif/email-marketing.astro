---
import Layout from '../../layouts/Layout.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import tools from '../../data/tools.json';

const category = tools["email-marketing"];

// Mapping des slugs pour les pages avis
const slugMap: Record<string, string> = {
  "GetResponse": "getresponse",
  "Brevo (ex-Sendinblue)": "brevo",
  "ActiveCampaign": "activecampaign"
};
---

<Layout title="Meilleur Logiciel Email Marketing 2026 : Comparatif & Avis" description="Brevo, GetResponse ou ActiveCampaign ? Comparatif complet des logiciels newsletter 2026. Offres gratuites, codes promo -30% et fonctionnalités détaillées.">

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">📧 Comparatif <span class="gradient-text">Email Marketing</span> 2026</h1>
    <p class="text-gray-400 mb-8">Les meilleurs logiciels pour vos newsletters et campagnes email</p>

    <div class="overflow-x-auto mb-12">
      <table class="w-full glass rounded-2xl overflow-hidden">
        <thead class="border-b border-white/10">
          <tr>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">Logiciel</th>
            <th class="px-4 py-4 text-left text-gray-400 text-sm">Prix</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Note</th>
            <th class="px-4 py-4 text-center text-gray-400 text-sm">Promo</th>
            <th class="px-4 py-4 text-right text-gray-400 text-sm">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {category.map(tool => (
            <tr class="hover:bg-white/5 transition">
              <td class="px-4 py-4">
                <a href={`/avis/${slugMap[tool.name]}`} class="flex items-center gap-3 group">
                  <ToolLogo name={tool.name} image={tool.image} logo={tool.logo} size="md" />
                  <div>
                    <div class="font-medium group-hover:text-gold transition">{tool.name}</div>
                    <div class="text-sm text-gray-500">{tool.shortDesc}</div>
                  </div>
                </a>
              </td>
              <td class="px-4 py-4 text-sm">
                {tool.originalPrice ? (
                  <div>
                    <span class="line-through text-gray-500">{tool.originalPrice}</span>
                    <span class="text-green-400 font-bold ml-2">{tool.price}</span>
                  </div>
                ) : (
                  <span class="text-gray-300">{tool.price}</span>
                )}
              </td>
              <td class="px-4 py-4 text-center">
                <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg font-medium text-sm">{tool.rating}/5</span>
              </td>
              <td class="px-4 py-4 text-center">
                <div class="flex flex-col gap-1 items-center">
                  {tool.discount && (
                    <span class="bg-red-500 text-white px-2 py-1 rounded-lg text-sm font-bold">{tool.discount}</span>
                  )}
                  {tool.promoText && (
                    <span class="bg-gold/20 text-gold px-2 py-1 rounded text-xs">{tool.promoText}</span>
                  )}
                </div>
              </td>
              <td class="px-4 py-4 text-right">
                <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-gold text-gray-900 px-5 py-2 rounded-lg text-sm font-medium hover:opacity-90 transition whitespace-nowrap">
                  Voir l'offre
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="text-2xl font-bold mb-6">Analyse détaillée</h2>
    <div class="space-y-6">
      {category.map(tool => (
        <div class="glass p-6 rounded-2xl card-hover">
          <div class="flex items-start justify-between mb-4">
            <a href={`/avis/${slugMap[tool.name]}`} class="flex items-center gap-3 group">
              <ToolLogo name={tool.name} image={tool.image} logo={tool.logo} size="lg" />
              <div>
                <h3 class="text-xl font-bold group-hover:text-gold transition">{tool.name}</h3>
                <p class="text-gray-400">{tool.description}</p>
              </div>
            </a>
            <span class="bg-purple-500/20 text-purple-300 px-3 py-1 rounded-full font-medium">{tool.rating}/5</span>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-4">
            <div>
              <h4 class="font-medium text-green-400 mb-2">✅ Avantages</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.pros.map(pro => <li>• {pro}</li>)}
              </ul>
            </div>
            <div>
              <h4 class="font-medium text-red-400 mb-2">❌ Inconvénients</h4>
              <ul class="text-sm space-y-1 text-gray-300">
                {tool.cons.map(con => <li>• {con}</li>)}
              </ul>
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-white/10">
            <div class="flex items-center gap-3">
              {tool.originalPrice ? (
                <>
                  <span class="line-through text-gray-500">{tool.originalPrice}</span>
                  <span class="font-bold text-green-400 text-lg">{tool.price}</span>
                  <span class="bg-red-500 text-white px-2 py-1 rounded text-sm font-bold">{tool.discount}</span>
                </>
              ) : (
                <span class="font-medium text-white">{tool.price}</span>
              )}
              {tool.promoText && <span class="text-gold text-sm">+ {tool.promoText}</span>}
            </div>
            <div class="flex gap-3">
              {slugMap[tool.name] && (
                <a href={`/avis/${slugMap[tool.name]}`} class="border border-purple-500/50 text-purple-300 px-4 py-2 rounded-xl text-sm hover:bg-purple-500/20 transition">
                  Lire l'avis
                </a>
              )}
              <a href={tool.affiliateUrl} target="_blank" rel="noopener" class="bg-gold text-gray-900 px-6 py-2 rounded-xl font-medium hover:opacity-90 transition">
                Voir l'offre
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-bold mb-6">❓ Questions Fréquentes</h2>
      <div class="space-y-4">
        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Quel logiciel email marketing choisir pour débuter ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Pour débuter, nous recommandons <a href="/avis/brevo" class="text-gold hover:underline">Brevo</a> (ex-Sendinblue) qui propose un plan gratuit généreux (300 emails/jour) et une interface en français. C'est idéal pour tester l'email marketing sans investissement initial.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Quelle est la différence entre newsletter et marketing automation ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            La newsletter est un email envoyé manuellement à toute votre liste. Le marketing automation envoie des emails automatiquement selon des déclencheurs (inscription, achat, anniversaire...). Pour l'automation avancée, <a href="/avis/activecampaign" class="text-gold hover:underline">ActiveCampaign</a> est le plus puissant.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Combien coûte un logiciel d'email marketing ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Les prix varient selon le nombre de contacts : gratuit pour débuter (Brevo), puis entre 15€ et 50€/mois pour 1000-5000 contacts. <a href="/avis/getresponse" class="text-gold hover:underline">GetResponse</a> offre un bon rapport qualité/prix dès 15,60€/mois.
          </div>
        </details>

        <details class="glass rounded-xl group">
          <summary class="px-6 py-4 cursor-pointer font-medium hover:text-gold transition flex justify-between items-center">
            Faut-il un logiciel RGPD compliant ?
            <span class="text-gray-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <div class="px-6 pb-4 text-gray-300">
            Oui, c'est obligatoire en Europe. Tous les logiciels de notre comparatif sont conformes au RGPD avec gestion du consentement, désabonnement facile et hébergement des données approprié. Brevo est particulièrement bien positionné car c'est une entreprise française.
          </div>
        </details>
      </div>
    </section>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Quel logiciel email marketing choisir pour débuter ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pour débuter, nous recommandons Brevo (ex-Sendinblue) qui propose un plan gratuit généreux (300 emails/jour) et une interface en français. C'est idéal pour tester l'email marketing sans investissement initial."
        }
      },
      {
        "@type": "Question",
        "name": "Quelle est la différence entre newsletter et marketing automation ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La newsletter est un email envoyé manuellement à toute votre liste. Le marketing automation envoie des emails automatiquement selon des déclencheurs (inscription, achat, anniversaire...). Pour l'automation avancée, ActiveCampaign est le plus puissant."
        }
      },
      {
        "@type": "Question",
        "name": "Combien coûte un logiciel d'email marketing ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Les prix varient selon le nombre de contacts : gratuit pour débuter (Brevo), puis entre 15€ et 50€/mois pour 1000-5000 contacts. GetResponse offre un bon rapport qualité/prix dès 15,60€/mois."
        }
      },
      {
        "@type": "Question",
        "name": "Faut-il un logiciel RGPD compliant ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Oui, c'est obligatoire en Europe. Tous les logiciels de notre comparatif sont conformes au RGPD avec gestion du consentement, désabonnement facile et hébergement des données approprié. Brevo est particulièrement bien positionné car c'est une entreprise française."
        }
      }
    ]
  })} />
</Layout>
