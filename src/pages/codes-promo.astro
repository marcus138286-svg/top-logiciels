---
import Layout from '../layouts/Layout.astro';
import tools from '../data/tools.json';

const allTools = [...tools["email-marketing"], ...tools["crm"], ...tools["outils-ia"], ...tools["compta-finance"]];
const toolsWithPromo = allTools.filter(t => t.promoCode || t.promoText);
---

<Layout title="Codes Promo SaaS - Réductions Exclusives" description="Tous les codes promo et réductions pour vos logiciels SaaS préférés">

  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">🎁 <span class="gradient-text">Codes Promo</span> & <span class="text-gold">Réductions</span></h1>
    <p class="text-gray-400 mb-8">Économisez sur vos abonnements logiciels</p>

    <div class="space-y-4">
      {toolsWithPromo.map(tool => (
        <div class="glass p-6 rounded-2xl flex flex-col md:flex-row md:items-center justify-between gap-4 card-hover border border-gold/20">
          <div class="flex items-center gap-4">
            <span class="text-3xl">{tool.logo}</span>
            <div>
              <h3 class="font-bold text-lg">{tool.name}</h3>
              <p class="text-sm text-gray-400">{tool.shortDesc}</p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            {tool.promoCode && (
              <div class="bg-gold/10 border-2 border-dashed border-gold/50 px-4 py-2 rounded-xl text-center">
                <div class="text-xs text-gray-500">Code promo</div>
                <div class="font-mono font-bold text-gold">{tool.promoCode}</div>
              </div>
            )}

            <div class="text-right">
              {tool.promoText && <div class="text-gold font-medium text-sm">{tool.promoText}</div>}
              <a
                href={tool.affiliateUrl}
                target="_blank"
                rel="noopener"
                class="inline-block mt-1 bg-gold text-gray-900 px-4 py-2 rounded-xl text-sm font-medium hover:opacity-90 transition"
              >
                Obtenir l'offre →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    {toolsWithPromo.length === 0 && (
      <div class="glass p-8 rounded-2xl text-center">
        <p class="text-gray-400">Aucune promotion active pour le moment.</p>
        <p class="text-gray-500 text-sm mt-2">Revenez bientôt pour de nouvelles offres !</p>
      </div>
    )}
  </section>
</Layout>
