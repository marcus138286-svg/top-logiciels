---
import Layout from '../layouts/Layout.astro';
import tools from '../data/tools.json';

const allTools = [...tools["email-marketing"], ...tools["crm"], ...tools["outils-ia"]];
const toolsWithPromo = allTools.filter(t => t.promoCode || t.promoText);
---

<Layout title="Codes Promo SaaS - Réductions Exclusives" description="Tous les codes promo et réductions pour vos logiciels SaaS préférés">

  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">🎁 Codes Promo & Réductions</h1>
    <p class="text-gray-600 mb-8">Économisez sur vos abonnements logiciels</p>

    <div class="space-y-4">
      {toolsWithPromo.map(tool => (
        <div class="bg-white p-6 rounded-xl border shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <span class="text-3xl">{tool.logo}</span>
            <div>
              <h3 class="font-bold text-lg">{tool.name}</h3>
              <p class="text-sm text-gray-600">{tool.shortDesc}</p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            {tool.promoCode && (
              <div class="bg-yellow-100 border-2 border-dashed border-yellow-400 px-4 py-2 rounded-lg text-center">
                <div class="text-xs text-gray-500">Code promo</div>
                <div class="font-mono font-bold text-yellow-800">{tool.promoCode}</div>
              </div>
            )}

            <div class="text-right">
              {tool.promoText && <div class="text-green-600 font-medium text-sm">{tool.promoText}</div>}
              <a
                href={tool.affiliateUrl}
                target="_blank"
                rel="noopener"
                class="inline-block mt-1 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700"
              >
                Obtenir l'offre →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
