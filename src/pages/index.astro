---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SaaS Deals - Comparatifs et Codes Promo Logiciels">
  <!-- Hero -->
  <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl font-bold mb-4">Trouvez le meilleur logiciel au meilleur prix</h1>
      <p class="text-xl opacity-90 mb-8">Comparatifs honnêtes + codes promo exclusifs</p>
      <a href="/codes-promo" class="bg-white text-blue-600 px-6 py-3 rounded-lg font-medium hover:bg-gray-100">
        Voir les codes promo →
      </a>
    </div>
  </section>

  <!-- Catégories -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold mb-8 text-center">Nos comparatifs</h2>
    <div class="grid md:grid-cols-4 gap-6">

      <a href="/comparatif/email-marketing" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition border">
        <div class="text-3xl mb-3">📧</div>
        <h3 class="font-bold text-lg mb-2">Email Marketing</h3>
        <p class="text-gray-600 text-sm">GetResponse, Brevo...</p>
      </a>

      <a href="/comparatif/crm" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition border">
        <div class="text-3xl mb-3">👥</div>
        <h3 class="font-bold text-lg mb-2">CRM</h3>
        <p class="text-gray-600 text-sm">HubSpot, Pipedrive...</p>
      </a>

      <a href="/comparatif/outils-ia" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition border">
        <div class="text-3xl mb-3">🤖</div>
        <h3 class="font-bold text-lg mb-2">Outils IA</h3>
        <p class="text-gray-600 text-sm">Jasper, Copy.ai...</p>
      </a>

      <a href="/comparatif/compta-finance" class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition border">
        <div class="text-3xl mb-3">💰</div>
        <h3 class="font-bold text-lg mb-2">Compta & Finance</h3>
        <p class="text-gray-600 text-sm">Pennylane, Qonto...</p>
      </a>

    </div>
  </section>

  <!-- Codes promo highlight -->
  <section class="bg-yellow-50 py-12">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-4">🎁 Codes promo du moment</h2>
      <div class="grid md:grid-cols-2 gap-4 mt-6">

        <div class="bg-white p-4 rounded-lg border-2 border-dashed border-yellow-400">
          <span class="font-bold text-lg">GetResponse</span>
          <span class="ml-2 bg-yellow-400 text-yellow-900 px-2 py-1 rounded text-sm font-mono">-30%</span>
          <p class="text-sm text-gray-600 mt-1">Sur tous les plans annuels</p>
        </div>

        <div class="bg-white p-4 rounded-lg border-2 border-dashed border-yellow-400">
          <span class="font-bold text-lg">Pipedrive</span>
          <span class="ml-2 bg-yellow-400 text-yellow-900 px-2 py-1 rounded text-sm font-mono">14 jours gratuits</span>
          <p class="text-sm text-gray-600 mt-1">Essai prolongé exclusif</p>
        </div>

      </div>
      <a href="/codes-promo" class="inline-block mt-6 text-blue-600 font-medium hover:underline">
        Voir tous les codes →
      </a>
    </div>
  </section>
</Layout>
