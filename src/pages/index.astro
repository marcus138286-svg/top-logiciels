---
import Layout from '../layouts/Layout.astro';
import tools from '../data/tools.json';

const allLogos = [
  ...tools["email-marketing"],
  ...tools["crm"],
  ...tools["outils-ia"],
  ...tools["compta-finance"]
].map(t => t.image);
---

<Layout title="SaaS Deals - Comparatifs et Codes Promo Logiciels">

  <!-- Logos flottants en arrière-plan -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none" style="z-index: 1;">
    {allLogos.map((logo, i) => (
      <img
        src={logo}
        alt=""
        class="floating-logo absolute rounded-xl"
        style={`
          width: ${60 + (i % 3) * 20}px;
          height: ${60 + (i % 3) * 20}px;
          left: ${3 + (i * 8) % 90}%;
          top: ${3 + (i * 9) % 90}%;
          opacity: 0.5;
          animation: float-random ${5 + (i % 4) * 2}s ease-in-out infinite;
          animation-delay: ${i * 0.2}s;
        `}
      />
    ))}
  </div>

  <!-- Hero -->
  <section class="py-20 px-4 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-block mb-6 px-4 py-2 rounded-full glass text-sm text-gray-400">
        ✨ +50 logiciels comparés • Codes promo exclusifs
      </div>
      <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
        Trouvez le <span class="gradient-text">meilleur logiciel</span><br>
        au <span class="text-gold">meilleur prix</span>
      </h1>
      <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
        Comparatifs honnêtes, codes promo exclusifs et conseils personnalisés par notre assistant IA
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/codes-promo" class="bg-gold text-gray-900 px-8 py-4 rounded-xl font-semibold hover:opacity-90 transition animate-pulse-glow">
          Voir les promos 🎁
        </a>
        <a href="#categories" class="glass px-8 py-4 rounded-xl font-medium hover:bg-white/10 transition">
          Explorer →
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-10 border-y border-white/10">
    <div class="max-w-4xl mx-auto px-4 grid grid-cols-3 gap-8 text-center">
      <div>
        <div class="text-3xl font-bold text-gold">12+</div>
        <div class="text-gray-500 text-sm">Logiciels testés</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-gold">-30%</div>
        <div class="text-gray-500 text-sm">Économies moyennes</div>
      </div>
      <div>
        <div class="text-3xl font-bold text-gold">100%</div>
        <div class="text-gray-500 text-sm">Indépendant</div>
      </div>
    </div>
  </section>

  <!-- Catégories -->
  <section id="categories" class="max-w-6xl mx-auto px-4 py-20">
    <h2 class="text-3xl font-bold mb-4 text-center">Nos comparatifs</h2>
    <p class="text-gray-500 text-center mb-12">Choisissez une catégorie pour trouver l'outil idéal</p>

    <div class="grid md:grid-cols-4 gap-6">

      <a href="/comparatif/email-marketing" class="glass p-6 rounded-2xl card-hover group">
        <div class="text-4xl mb-4 animate-float">📧</div>
        <h3 class="font-bold text-lg mb-2 group-hover:text-gold transition">Email Marketing</h3>
        <p class="text-gray-500 text-sm">GetResponse, Brevo...</p>
        <div class="mt-4 text-purple-400 text-sm font-medium">3 outils →</div>
      </a>

      <a href="/comparatif/crm" class="glass p-6 rounded-2xl card-hover group">
        <div class="text-4xl mb-4 animate-float" style="animation-delay: 0.5s">👥</div>
        <h3 class="font-bold text-lg mb-2 group-hover:text-gold transition">CRM</h3>
        <p class="text-gray-500 text-sm">Gestion de la Relation Client</p>
        <p class="text-gray-600 text-xs">HubSpot, Pipedrive...</p>
        <div class="mt-4 text-purple-400 text-sm font-medium">2 outils →</div>
      </a>

      <a href="/comparatif/outils-ia" class="glass p-6 rounded-2xl card-hover group">
        <div class="text-4xl mb-4 animate-float" style="animation-delay: 1s">🤖</div>
        <h3 class="font-bold text-lg mb-2 group-hover:text-gold transition">Outils IA</h3>
        <p class="text-gray-500 text-sm">Jasper, Copy.ai...</p>
        <div class="mt-4 text-purple-400 text-sm font-medium">2 outils →</div>
      </a>

      <a href="/comparatif/compta-finance" class="glass p-6 rounded-2xl card-hover group">
        <div class="text-4xl mb-4 animate-float" style="animation-delay: 1.5s">💰</div>
        <h3 class="font-bold text-lg mb-2 group-hover:text-gold transition">Compta & Finance</h3>
        <p class="text-gray-500 text-sm">Pennylane, Qonto...</p>
        <div class="mt-4 text-purple-400 text-sm font-medium">5 outils →</div>
      </a>

    </div>
  </section>

  <!-- Codes promo highlight -->
  <section class="py-16 relative">
    <div class="absolute inset-0 bg-gradient-to-r from-purple-900/20 via-violet-900/20 to-amber-900/20"></div>
    <div class="max-w-4xl mx-auto px-4 relative">
      <h2 class="text-3xl font-bold mb-4 text-center">
        🔥 <span class="text-gold">Promos</span> du moment
      </h2>
      <p class="text-gray-500 text-center mb-10">Offres exclusives négociées pour vous</p>

      <div class="grid md:grid-cols-2 gap-6">

        <div class="glass p-6 rounded-2xl border border-gold/30 card-hover">
          <div class="flex justify-between items-start mb-4">
            <div>
              <span class="text-xl font-bold">GetResponse</span>
              <p class="text-gray-500 text-sm">Email marketing</p>
            </div>
            <span class="bg-gold text-gray-900 px-3 py-1 rounded-full text-sm font-bold">-30%</span>
          </div>
          <p class="text-gray-400 text-sm mb-4">Sur tous les plans annuels</p>
          <a href="/codes-promo" class="text-gold font-medium text-sm hover:underline">Obtenir le code →</a>
        </div>

        <div class="glass p-6 rounded-2xl border border-gold/30 card-hover">
          <div class="flex justify-between items-start mb-4">
            <div>
              <span class="text-xl font-bold">Qonto</span>
              <p class="text-gray-500 text-sm">Banque pro</p>
            </div>
            <span class="bg-gold text-gray-900 px-3 py-1 rounded-full text-sm font-bold">1 mois offert</span>
          </div>
          <p class="text-gray-400 text-sm mb-4">Pour toute ouverture de compte</p>
          <a href="/codes-promo" class="text-gold font-medium text-sm hover:underline">Obtenir l'offre →</a>
        </div>

      </div>

      <div class="text-center mt-10">
        <a href="/codes-promo" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition">
          Voir toutes les promos <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold mb-4 text-center">💬 Ce qu'ils en pensent</h2>
    <p class="text-gray-500 text-center mb-10">Des entrepreneurs comme vous</p>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="glass p-6 rounded-2xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-purple-500/30 flex items-center justify-center">M</div>
          <div>
            <div class="font-medium">Marie L.</div>
            <div class="text-gray-500 text-sm">Freelance marketing</div>
          </div>
        </div>
        <p class="text-gray-300 text-sm">
          "J'ai économisé <span class="text-gold">150€</span> sur mon abonnement GetResponse grâce au code promo. Le comparatif m'a vraiment aidée à choisir."
        </p>
        <div class="mt-3 text-gold text-sm">★★★★★</div>
      </div>

      <div class="glass p-6 rounded-2xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-purple-500/30 flex items-center justify-center">T</div>
          <div>
            <div class="font-medium">Thomas R.</div>
            <div class="text-gray-500 text-sm">Gérant e-commerce</div>
          </div>
        </div>
        <p class="text-gray-300 text-sm">
          "Le chatbot m'a recommandé Pipedrive pour mon équipe commerciale. Parfait pour notre besoin, et le <span class="text-gold">mois offert</span> était bienvenu !"
        </p>
        <div class="mt-3 text-gold text-sm">★★★★★</div>
      </div>

      <div class="glass p-6 rounded-2xl">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-purple-500/30 flex items-center justify-center">S</div>
          <div>
            <div class="font-medium">Sophie B.</div>
            <div class="text-gray-500 text-sm">Auto-entrepreneuse</div>
          </div>
        </div>
        <p class="text-gray-300 text-sm">
          "Enfin un site qui donne les vrais <span class="text-gold">avantages et inconvénients</span>. Pas juste de la pub. J'ai trouvé Pennylane pour ma compta."
        </p>
        <div class="mt-3 text-gold text-sm">★★★★☆</div>
      </div>
    </div>
  </section>

  <!-- Comment ça marche -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold mb-4 text-center">🎯 Comment ça marche</h2>
    <p class="text-gray-500 text-center mb-12">3 étapes pour trouver votre outil idéal</p>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-purple-500/20 flex items-center justify-center text-2xl">1</div>
        <h3 class="font-bold mb-2">Comparez</h3>
        <p class="text-gray-400 text-sm">Consultez nos comparatifs détaillés avec les vrais avantages et inconvénients</p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-purple-500/20 flex items-center justify-center text-2xl">2</div>
        <h3 class="font-bold mb-2">Économisez</h3>
        <p class="text-gray-400 text-sm">Utilisez nos codes promo exclusifs pour obtenir les meilleurs tarifs</p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-purple-500/20 flex items-center justify-center text-2xl">3</div>
        <h3 class="font-bold mb-2">Lancez-vous</h3>
        <p class="text-gray-400 text-sm">Testez l'outil avec un essai gratuit et voyez s'il vous convient</p>
      </div>
    </div>
  </section>

  <!-- Blog / Guides récents -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <div class="flex justify-between items-center mb-8">
      <div>
        <h2 class="text-3xl font-bold">📚 Guides récents</h2>
        <p class="text-gray-500 mt-2">Conseils pour bien choisir vos outils</p>
      </div>
      <a href="/blog" class="text-purple-400 hover:text-purple-300 text-sm">Voir tout →</a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <a href="/blog/outils-freelance-2026" class="glass p-5 rounded-2xl card-hover group">
        <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg text-xs">Freelance</span>
        <h3 class="font-bold mt-3 mb-2 group-hover:text-gold transition">Les Outils Indispensables du Freelance</h3>
        <p class="text-gray-500 text-sm">La stack complète pour bien démarrer en 2026</p>
      </a>
      <a href="/blog/comment-choisir-crm" class="glass p-5 rounded-2xl card-hover group">
        <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg text-xs">CRM</span>
        <h3 class="font-bold mt-3 mb-2 group-hover:text-gold transition">Comment choisir son CRM ?</h3>
        <p class="text-gray-500 text-sm">Guide complet pour trouver le bon outil</p>
      </a>
      <a href="/blog/gratuit-vs-payant" class="glass p-5 rounded-2xl card-hover group">
        <span class="bg-purple-500/20 text-purple-300 px-2 py-1 rounded-lg text-xs">Guide</span>
        <h3 class="font-bold mt-3 mb-2 group-hover:text-gold transition">Gratuit vs Payant : Comment Choisir ?</h3>
        <p class="text-gray-500 text-sm">Ne vous trompez pas dans votre choix</p>
      </a>
    </div>
  </section>

  <!-- Pourquoi nous faire confiance -->
  <section class="py-16 relative">
    <div class="absolute inset-0 bg-gradient-to-r from-violet-900/10 via-purple-900/10 to-violet-900/10"></div>
    <div class="max-w-5xl mx-auto px-4 relative">
      <h2 class="text-3xl font-bold mb-4 text-center">✅ Pourquoi nous faire confiance</h2>
      <p class="text-gray-500 text-center mb-12">Des avis honnêtes, pas de la pub déguisée</p>

      <div class="grid md:grid-cols-4 gap-6">
        <div class="glass p-5 rounded-2xl text-center">
          <div class="text-3xl mb-3">🔍</div>
          <h3 class="font-bold text-sm mb-2">Tests réels</h3>
          <p class="text-gray-500 text-xs">Chaque outil est testé en conditions réelles</p>
        </div>
        <div class="glass p-5 rounded-2xl text-center">
          <div class="text-3xl mb-3">⚖️</div>
          <h3 class="font-bold text-sm mb-2">Comparatifs objectifs</h3>
          <p class="text-gray-500 text-xs">Avantages ET inconvénients de chaque outil</p>
        </div>
        <div class="glass p-5 rounded-2xl text-center">
          <div class="text-3xl mb-3">🎁</div>
          <h3 class="font-bold text-sm mb-2">Promos vérifiées</h3>
          <p class="text-gray-500 text-xs">Codes testés et mis à jour régulièrement</p>
        </div>
        <div class="glass p-5 rounded-2xl text-center">
          <div class="text-3xl mb-3">🇫🇷</div>
          <h3 class="font-bold text-sm mb-2">100% français</h3>
          <p class="text-gray-500 text-xs">Site indépendant basé en France</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Assistant -->
  <section class="max-w-4xl mx-auto px-4 py-20 text-center">
    <div class="glass p-10 rounded-3xl border border-purple-500/30">
      <div class="text-5xl mb-6">🤖</div>
      <h2 class="text-2xl font-bold mb-4">Besoin d'aide pour choisir ?</h2>
      <p class="text-gray-400 mb-6">Notre assistant IA analyse vos besoins et vous recommande le meilleur outil</p>
      <p class="text-purple-400 text-sm">Cliquez sur le bouton 💬 en bas à droite</p>
    </div>
  </section>

</Layout>
