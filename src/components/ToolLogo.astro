---
interface Props {
  name: string;
  image?: string;
  logo: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, image, logo, size = 'md' } = Astro.props;

const sizes = {
  sm: { width: 32, height: 32, text: 'text-xl' },
  md: { width: 48, height: 48, text: 'text-2xl' },
  lg: { width: 64, height: 64, text: 'text-3xl' }
};

const { width, height, text } = sizes[size];
---

{image ? (
  <img
    src={image}
    alt={`Logo ${name}`}
    width={width}
    height={height}
    loading="lazy"
    class="rounded-lg object-contain"
    onerror={`this.style.display='none';this.nextElementSibling.style.display='flex';`}
  />
  <span class={`${text} hidden items-center justify-center`} style={`width:${width}px;height:${height}px;`}>
    {logo}
  </span>
) : (
  <span class={`${text} flex items-center justify-center`} style={`width:${width}px;height:${height}px;`}>
    {logo}
  </span>
)}
