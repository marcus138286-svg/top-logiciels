---
interface Props {
  name: string;
  image?: string;
  logo: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, image, logo, size = 'md' } = Astro.props;

const sizes = {
  sm: { width: 24, height: 24, text: 'text-lg' },
  md: { width: 40, height: 40, text: 'text-2xl' },
  lg: { width: 56, height: 56, text: 'text-3xl' }
};

const { width, height, text } = sizes[size];
---

<span class="tool-logo inline-flex items-center justify-center" style={`width:${width}px;height:${height}px;`}>
  {image ? (
    <img
      src={image}
      alt={`Logo ${name}`}
      width={width}
      height={height}
      loading="lazy"
      class="rounded-lg object-contain max-w-full max-h-full"
      onerror="this.style.display='none';this.nextElementSibling.style.display='inline';"
    />
    <span class={`${text} hidden`}>{logo}</span>
  ) : (
    <span class={text}>{logo}</span>
  )}
</span>
