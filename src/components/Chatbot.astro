---
// Composant Chatbot - Theme dark premium
---

<div id="chatbot-container">
  <!-- Bulle d'aide -->
  <div id="chat-hint" class="fixed bottom-24 right-6 glass px-4 py-2 rounded-xl text-sm text-white z-50 animate-bounce-hint">
    <span class="text-gold">Besoin d'aide ?</span> Demande-moi !
    <div class="absolute -bottom-2 right-6 w-0 h-0 border-l-8 border-r-8 border-t-8 border-transparent border-t-white/10"></div>
  </div>

  <!-- Bouton flottant -->
  <button
    id="chat-toggle"
    class="fixed bottom-6 right-6 w-16 h-16 rounded-full shadow-2xl transition-all flex items-center justify-center text-3xl z-50 chat-button-glow hover:scale-110"
    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
  >
    💬
  </button>

  <!-- Fenêtre de chat -->
  <div
    id="chat-window"
    class="fixed bottom-24 right-6 w-80 rounded-2xl shadow-2xl hidden z-50 flex flex-col glass border border-purple-500/30"
    style="height: 420px;"
  >
    <!-- Header -->
    <div class="px-4 py-3 rounded-t-2xl flex justify-between items-center border-b border-white/10" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <span class="font-medium text-white flex items-center gap-2">
        <span class="text-xl">🤖</span> Assistant SaaSDeals
      </span>
      <button id="chat-close" class="text-white/80 hover:text-white transition text-lg">✕</button>
    </div>

    <!-- Messages -->
    <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-3 bg-gray-950/50">
      <div class="glass rounded-xl p-3 text-sm text-gray-200 mr-6">
        Salut ! Dis-moi ce dont tu as besoin, je te recommande le <span class="text-gold">logiciel adapté</span>. 🎯
      </div>
    </div>

    <!-- Input -->
    <div class="border-t border-white/10 p-3 bg-gray-900/50 rounded-b-2xl">
      <form id="chat-form" class="flex gap-2">
        <!-- Honeypot anti-bot (invisible) -->
        <input type="text" name="website" id="hp-field" class="hidden" tabindex="-1" autocomplete="off" />
        <input type="hidden" id="chat-ts" value="" />

        <input
          type="text"
          id="chat-input"
          placeholder="Ex: Je veux envoyer des newsletters"
          class="flex-1 bg-gray-800/50 border border-white/10 rounded-xl px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-purple-500/50 transition"
          maxlength="500"
        />
        <button
          type="submit"
          class="bg-gold text-gray-900 px-4 py-2 rounded-xl text-sm font-medium hover:opacity-90 transition"
        >
          →
        </button>
      </form>
      <p class="text-xs text-gray-500 mt-2 text-center">15 messages/heure max</p>
    </div>
  </div>
</div>

<style>
  @keyframes bounce-hint {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .animate-bounce-hint {
    animation: bounce-hint 2s ease-in-out infinite;
  }

  .chat-button-glow {
    box-shadow:
      0 0 20px rgba(102, 126, 234, 0.5),
      0 0 40px rgba(118, 75, 162, 0.3),
      0 0 60px rgba(102, 126, 234, 0.2);
    animation: chat-glow 2s ease-in-out infinite;
  }

  @keyframes chat-glow {
    0%, 100% {
      box-shadow:
        0 0 20px rgba(102, 126, 234, 0.5),
        0 0 40px rgba(118, 75, 162, 0.3),
        0 0 60px rgba(102, 126, 234, 0.2);
    }
    50% {
      box-shadow:
        0 0 30px rgba(102, 126, 234, 0.7),
        0 0 60px rgba(118, 75, 162, 0.5),
        0 0 90px rgba(102, 126, 234, 0.3);
    }
  }
</style>

<script>
  const toggle = document.getElementById('chat-toggle');
  const chatWindow = document.getElementById('chat-window');
  const close = document.getElementById('chat-close');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const messages = document.getElementById('chat-messages');
  const hpField = document.getElementById('hp-field') as HTMLInputElement;
  const tsField = document.getElementById('chat-ts') as HTMLInputElement;
  const hint = document.getElementById('chat-hint');

  let isOpen = false;

  // Cacher la bulle après 5 secondes
  setTimeout(() => {
    hint?.classList.add('opacity-0', 'transition-opacity', 'duration-500');
    setTimeout(() => hint?.remove(), 500);
  }, 5000);

  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    chatWindow?.classList.toggle('hidden', !isOpen);
    toggle.textContent = isOpen ? '✕' : '💬';
    hint?.remove();
    // Enregistrer timestamp à l'ouverture
    if (isOpen && tsField) {
      tsField.value = Date.now().toString();
    }
  });

  close?.addEventListener('click', () => {
    isOpen = false;
    chatWindow?.classList.add('hidden');
    toggle!.textContent = '💬';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = input.value.trim();
    if (!message) return;

    // Anti-bot checks
    const honeypot = hpField?.value || '';
    const timestamp = parseInt(tsField?.value || '0');

    // Afficher message user
    addMessage(message, 'user');
    input.value = '';

    // Afficher "typing"
    const typingId = addMessage('...', 'bot');

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message, honeypot, timestamp })
      });

      const data = await response.json();

      // Remplacer typing par réponse
      removeMessage(typingId);
      addMessage(data.reply || data.error || "Erreur", 'bot');

    } catch {
      removeMessage(typingId);
      addMessage("Erreur de connexion. Réessaie.", 'bot');
    }
  });

  function addMessage(text: string, sender: 'user' | 'bot'): string {
    const id = 'msg-' + Date.now();
    const div = document.createElement('div');
    div.id = id;
    div.className = sender === 'user'
      ? 'rounded-xl p-3 text-sm ml-6 text-white'
      : 'glass rounded-xl p-3 text-sm mr-6 text-gray-200';
    if (sender === 'user') {
      div.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
    }
    div.textContent = text;
    messages?.appendChild(div);
    messages!.scrollTop = messages!.scrollHeight;
    return id;
  }

  function removeMessage(id: string) {
    document.getElementById(id)?.remove();
  }
</script>
